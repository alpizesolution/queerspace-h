rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ====================================================
    // GLOBAL HELPER FUNCTIONS
    // ====================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Role Escalation Defense: Client-writable documents MUST NOT contain 'role', 'isAdmin', or 'isModerator'
    function hasNoPrivilegedFields() {
      return !('role' in request.resource.data) &&
             !('isAdmin' in request.resource.data) &&
             !('isModerator' in request.resource.data);
    }

    // Validates that a conversation has exactly 2 distinct UIDs, including request.auth.uid
    function isValidNewConversation() {
      let p = request.resource.data.participants;
      return p is list 
        && p.size() == 2 
        && p[0] is string 
        && p[1] is string 
        && p[0] != p[1] 
        && request.auth.uid in p;
    }

    // Verifies conversation participants cannot be modified after creation
    function areParticipantsUnchanged() {
      return request.resource.data.participants == resource.data.participants;
    }

    // Verifies if request user is a participant of an existing conversation
    function isConversationParticipant(convId) {
      return isAuthenticated() && 
        request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participants;
    }

    // Valid categories for community posts
    function isValidCategory(cat) {
      return cat in ['general', 'media', 'vents', 'friends', 'advice'];
    }

    // ====================================================
    // SLOW MODE (anti-spam)
    // ====================================================
    // rate_limits/{uid} remembers when a user last posted to each surface.
    // A post must stamp its field with request.time in the same batch, and is
    // only allowed if the previous stamp is at least `secs` seconds old.

    function rateLimitPath() {
      return /databases/$(database)/documents/rate_limits/$(request.auth.uid);
    }

    function slowMode(field, secs) {
      let before = exists(rateLimitPath()) ? get(rateLimitPath()).data : {};
      return getAfter(rateLimitPath()).data.get(field, null) == request.time
        && (!(field in before) || before[field] + duration.value(secs, 's') <= request.time);
    }

    match /rate_limits/{userId} {
      allow read: if isOwner(userId);
      // Only stamps of "now" can be written, so the clock can't be wound back.
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['publicRoom', 'unsaid', 'suggestion'])
        && (!('publicRoom' in request.resource.data.diff(resource == null ? {} : resource.data).affectedKeys())
            || request.resource.data.publicRoom == request.time)
        && (!('unsaid' in request.resource.data.diff(resource == null ? {} : resource.data).affectedKeys())
            || request.resource.data.unsaid == request.time)
        && (!('suggestion' in request.resource.data.diff(resource == null ? {} : resource.data).affectedKeys())
            || request.resource.data.suggestion == request.time);
      allow delete: if false;
    }

    // ====================================================
    // 0. INDEXED COLLECTION GROUPS
    // ====================================================
    
    // Allow querying all public profiles across all users
    match /{path=**}/profile/{profileId} {
      allow read: if isAuthenticated();
    }

    // ====================================================
    // 1. PRIVACY BY DESIGN: USER PROFILES & PRIVATE SETTINGS
    // ====================================================

    // Private settings (SOGIE, exact location, matching filters, blocked user IDs)
    // READABLE & WRITABLE ONLY BY PROFILE OWNER. ZERO PUBLIC EXPOSURE.
    match /users/{userId}/private/settings {
      allow read: if isOwner(userId);

      allow create: if isOwner(userId)
        && hasNoPrivilegedFields()
        && request.resource.data.keys().hasAll(['createdAt', 'updatedAt'])
        && request.resource.data.keys().hasOnly([
             'exactLocation', 'sexualOrientation', 'genderExpression', 
             'preferredGenderExpressions', 'blockedPartnerIds', 'createdAt', 'updatedAt'
           ])
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;

      allow update: if isOwner(userId)
        && hasNoPrivilegedFields()
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.keys().hasOnly([
             'exactLocation', 'sexualOrientation', 'genderExpression', 
             'preferredGenderExpressions', 'blockedPartnerIds', 'createdAt', 'updatedAt'
           ])
        && request.resource.data.updatedAt is timestamp;

      allow delete: if false;
    }

    // Public Profile (displayName, pronouns, intention, region, topics)
    // READABLE BY ALL AUTHENTICATED USERS. WRITABLE ONLY BY OWNER.
    match /users/{userId}/public/profile {
      allow read: if isAuthenticated();

      allow create, update: if isOwner(userId)
        && hasNoPrivilegedFields()
        && request.resource.data.keys().hasAll(['displayName', 'pronouns', 'intention', 'region', 'topics', 'updatedAt'])
        && request.resource.data.keys().hasOnly([
             'displayName', 'pronouns', 'intention', 'topics', 
             'region', 'showGenderExpressionOnProfile', 'showSogieOnProfile', 
             'showLocationOnProfile', 'avatar', 'updatedAt'
           ])
        && (!('avatar' in request.resource.data)
            || (request.resource.data.avatar is string && request.resource.data.avatar.size() <= 24))
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 1
        && request.resource.data.displayName.size() <= 30
        && request.resource.data.pronouns is string
        && request.resource.data.pronouns.size() >= 1
        && request.resource.data.pronouns.size() <= 20
        && request.resource.data.intention is string
        && request.resource.data.region is string
        && request.resource.data.topics is list
        && request.resource.data.topics.size() <= 8
        && request.resource.data.updatedAt is timestamp;

      allow delete: if false;
    }

    // ====================================================
    // 1b. LIVE MATCHMAKING QUEUE
    // ====================================================
    // match_queue/{uid}: a user's own "I'm looking for a chat" entry.
    // Only waiting entries are visible to others; matched entries are visible
    // to the owner and the person they were paired with.

    function queueKeysValid() {
      return request.resource.data.keys().hasOnly([
               'status', 'partnerId', 'convId', 'createdAt', 'heartbeatAt', 'updatedAt'
             ])
        && request.resource.data.status in ['waiting', 'matched'];
    }

    function convHasParticipants(convId, a, b) {
      return convId is string
        && getAfter(/databases/$(database)/documents/conversations/$(convId)).data.participants.hasAll([a, b]);
    }

    match /match_queue/{userId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == userId
        || resource.data.status == 'waiting'
        || resource.data.partnerId == request.auth.uid
      );

      allow create: if isOwner(userId)
        && queueKeysValid()
        && request.resource.data.status == 'waiting'
        && request.resource.data.createdAt is timestamp
        && request.resource.data.heartbeatAt is timestamp;

      // Owner: heartbeat, reset to waiting, or mark self matched with a real conversation.
      allow update: if isOwner(userId)
        && queueKeysValid()
        && (request.resource.data.status == 'waiting'
            || convHasParticipants(request.resource.data.convId, userId, request.resource.data.partnerId));

      // Another searcher claims a waiting entry, but only by pairing it with themselves
      // in a conversation created in the same transaction.
      allow update: if isAuthenticated()
        && request.auth.uid != userId
        && resource.data.status == 'waiting'
        && request.resource.data.status == 'matched'
        && request.resource.data.partnerId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'partnerId', 'convId', 'updatedAt'])
        && convHasParticipants(request.resource.data.convId, request.auth.uid, userId);

      allow delete: if isOwner(userId);
    }

    // ====================================================
    // 2. 1-ON-1 CONVERSATIONS & EPHEMERAL MESSAGES
    // ====================================================

    match /conversations/{convId} {
      allow read: if isAuthenticated() && request.auth.uid in resource.data.participants;

      allow create: if isAuthenticated()
        && isValidNewConversation()
        && request.resource.data.keys().hasAll(['participants', 'createdAt', 'updatedAt', 'status'])
        && request.resource.data.keys().hasOnly(['participants', 'createdAt', 'updatedAt', 'status'])
        && request.resource.data.status == 'active'
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;

      // Status Transition Lock: 'ended' or 'blocked' conversations cannot be changed back to 'active'
      allow update: if isAuthenticated()
        && request.auth.uid in resource.data.participants
        && areParticipantsUnchanged()
        && resource.data.status == 'active'
        && request.resource.data.keys().hasOnly(['participants', 'createdAt', 'updatedAt', 'status'])
        && request.resource.data.status in ['active', 'ended', 'blocked']
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt is timestamp;

      allow delete: if false;

      // Ephemeral Chat Messages
      match /messages/{messageId} {
        allow read: if isConversationParticipant(convId);

        allow create: if isConversationParticipant(convId)
          && request.resource.data.keys().hasAll(['senderId', 'text', 'timestamp'])
          && request.resource.data.keys().hasOnly(['senderId', 'text', 'timestamp'])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1
          && request.resource.data.text.size() <= 1000
          && request.resource.data.timestamp is timestamp;

        allow update, delete: if false; // Messages are immutable
      }
    }

    // ====================================================
    // 3. PUBLIC ROOM MESSAGES (TOWN SQUARE)
    // ====================================================

    match /public_room_messages/{messageId} {
      allow read: if isAuthenticated();

      allow create: if isAuthenticated()
        && request.resource.data.keys().hasAll(['authorId', 'authorName', 'authorPronouns', 'text', 'timestamp'])
        && request.resource.data.keys().hasOnly(['authorId', 'authorName', 'authorPronouns', 'authorAvatar', 'text', 'timestamp'])
        && request.resource.data.authorId == request.auth.uid
        && (!('authorAvatar' in request.resource.data)
            || (request.resource.data.authorAvatar is string && request.resource.data.authorAvatar.size() <= 24))
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() >= 1
        && request.resource.data.authorName.size() <= 30
        && request.resource.data.authorPronouns is string
        && request.resource.data.authorPronouns.size() >= 1
        && request.resource.data.authorPronouns.size() <= 20
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 1000
        && request.resource.data.timestamp == request.time
        && slowMode('publicRoom', 2);

      allow update, delete: if false; // Immutable public room messages
    }

    // ====================================================
    // 4. HARDENED COMMUNITY POSTS & INDIVIDUAL LIKES
    // ====================================================

    match /community_posts/{postId} {
      allow read: if isAuthenticated();

      allow create: if isAuthenticated()
        && request.resource.data.keys().hasAll(['authorId', 'authorName', 'title', 'content', 'category', 'tags', 'timestamp'])
        && request.resource.data.keys().hasOnly(['authorId', 'authorName', 'title', 'content', 'category', 'tags', 'timestamp', 'updatedAt'])
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() >= 1
        && request.resource.data.authorName.size() <= 30
        && isValidCategory(request.resource.data.category)
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 1
        && request.resource.data.title.size() <= 90
        && request.resource.data.content is string
        && request.resource.data.content.size() >= 1
        && request.resource.data.content.size() <= 1000
        && request.resource.data.tags is list
        && request.resource.data.tags.size() <= 4
        && request.resource.data.timestamp is timestamp;

      allow update: if isAuthenticated()
        && request.auth.uid == resource.data.authorId
        && request.resource.data.authorId == resource.data.authorId
        && request.resource.data.timestamp == resource.data.timestamp
        && request.resource.data.keys().hasOnly(['authorId', 'authorName', 'title', 'content', 'category', 'tags', 'timestamp', 'updatedAt'])
        && isValidCategory(request.resource.data.category)
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 1
        && request.resource.data.title.size() <= 90
        && request.resource.data.content is string
        && request.resource.data.content.size() >= 1
        && request.resource.data.content.size() <= 1000
        && request.resource.data.tags is list
        && request.resource.data.tags.size() <= 4
        && request.resource.data.updatedAt is timestamp;

      allow delete: if isAuthenticated() && request.auth.uid == resource.data.authorId;

      // Safe Individual Like Documents (/community_posts/{postId}/likes/{request.auth.uid})
      match /likes/{userId} {
        allow read: if isAuthenticated();

        allow create: if isOwner(userId)
          && request.resource.data.keys().hasAll(['createdAt'])
          && request.resource.data.keys().hasOnly(['createdAt'])
          && request.resource.data.createdAt is timestamp;

        allow delete: if isOwner(userId);
        allow update: if false;
      }
    }

    // ====================================================
    // 5. ABUSE & SAFETY REPORTS
    // ====================================================

    match /reports/{reportId} {
      allow create: if isAuthenticated()
        && request.resource.data.keys().hasAll(['reporterId', 'targetId', 'targetType', 'reason', 'timestamp'])
        && request.resource.data.keys().hasOnly(['reporterId', 'targetId', 'targetType', 'reason', 'timestamp'])
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.targetId is string
        && request.resource.data.targetType in ['user', 'message', 'post']
        && request.resource.data.reason is string
        && request.resource.data.reason.size() >= 1
        && request.resource.data.reason.size() <= 300
        && request.resource.data.timestamp is timestamp;

      // Strict Zero Client Read Policy
      allow read, update, delete: if false;
    }

    // ====================================================
    // 5b. UNSAID WALL (anonymous, fades after 48 hours)
    // ====================================================
    // Posts carry no author field. Ownership lives in unsaid_owners/{postId},
    // readable only by the author, so nobody can link a post to a profile.
    // Reaction and flag counters can only go up by one, together with a
    // per-user marker document, so each person counts once.

    function unsaidPath(postId) {
      return /databases/$(database)/documents/unsaid/$(postId);
    }

    function unsaidOwnerPath(postId) {
      return /databases/$(database)/documents/unsaid_owners/$(postId);
    }

    function bumpsOnly(field) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([field])
        && request.resource.data[field] == resource.data[field] + 1;
    }

    match /unsaid/{postId} {
      allow read: if isAuthenticated();

      allow create: if isAuthenticated()
        && request.resource.data.keys().hasAll(['kind', 'text', 'createdAt', 'expiresAt', 'hugs', 'same', 'flags'])
        && request.resource.data.keys().hasOnly(['kind', 'text', 'createdAt', 'expiresAt', 'hugs', 'same', 'flags'])
        && request.resource.data.kind in ['vent', 'confession']
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 500
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time + duration.value(47, 'h')
        && request.resource.data.expiresAt < request.time + duration.value(49, 'h')
        && request.resource.data.hugs == 0
        && request.resource.data.same == 0
        && request.resource.data.flags == 0
        && getAfter(unsaidOwnerPath(postId)).data.authorId == request.auth.uid
        && slowMode('unsaid', 60);

      // A reaction: +1 on 'hugs' or 'same' alongside a new reactions/{uid} doc of that type.
      allow update: if isAuthenticated()
        && (bumpsOnly('hugs') || bumpsOnly('same'))
        && !exists(/databases/$(database)/documents/unsaid/$(postId)/reactions/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/unsaid/$(postId)/reactions/$(request.auth.uid)).data.type
             in request.resource.data.diff(resource.data).affectedKeys();

      // A flag: +1 on 'flags' alongside a new flags/{uid} doc.
      allow update: if isAuthenticated()
        && bumpsOnly('flags')
        && !exists(/databases/$(database)/documents/unsaid/$(postId)/flags/$(request.auth.uid))
        && existsAfter(/databases/$(database)/documents/unsaid/$(postId)/flags/$(request.auth.uid));

      allow delete: if isAuthenticated()
        && get(unsaidOwnerPath(postId)).data.authorId == request.auth.uid;

      match /reactions/{userId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.keys().hasOnly(['type', 'createdAt'])
          && request.resource.data.type in ['hugs', 'same']
          && request.resource.data.createdAt == request.time
          && getAfter(unsaidPath(postId)).data[request.resource.data.type]
               == get(unsaidPath(postId)).data[request.resource.data.type] + 1;
        allow update, delete: if false;
      }

      match /flags/{userId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.keys().hasOnly(['createdAt'])
          && request.resource.data.createdAt == request.time
          && getAfter(unsaidPath(postId)).data.flags == get(unsaidPath(postId)).data.flags + 1;
        allow update, delete: if false;
      }
    }

    match /unsaid_owners/{postId} {
      allow read: if isAuthenticated() && resource.data.authorId == request.auth.uid;

      // Only for a brand-new post, created in the same batch.
      allow create: if isAuthenticated()
        && request.resource.data.keys().hasOnly(['authorId'])
        && request.resource.data.authorId == request.auth.uid
        && !exists(unsaidPath(postId))
        && existsAfter(unsaidPath(postId));

      allow delete: if isAuthenticated()
        && resource.data.authorId == request.auth.uid
        && !existsAfter(unsaidPath(postId));
      allow update: if false;
    }

    // ====================================================
    // 6. SUGGESTIONS & FEEDBACK
    // ====================================================
    // Write-only from the app; read in the Firebase Console.

    match /suggestions/{suggestionId} {
      allow create: if isAuthenticated()
        && request.resource.data.keys().hasAll(['authorId', 'category', 'text', 'createdAt'])
        && request.resource.data.keys().hasOnly(['authorId', 'category', 'text', 'createdAt'])
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.category in ['idea', 'bug', 'safety', 'other']
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 3
        && request.resource.data.text.size() <= 1000
        && request.resource.data.createdAt == request.time
        && slowMode('suggestion', 30);

      allow read, update, delete: if false;
    }
  }
}
