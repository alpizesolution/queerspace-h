rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ====================================================
    // GLOBAL HELPER FUNCTIONS
    // ====================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Role Escalation Defense: Client-writable documents MUST NOT contain 'role', 'isAdmin', or 'isModerator'
    function hasNoPrivilegedFields() {
      return !('role' in request.resource.data) &&
             !('isAdmin' in request.resource.data) &&
             !('isModerator' in request.resource.data);
    }

    // Validates that a conversation has exactly 2 distinct UIDs, including request.auth.uid
    function isValidNewConversation() {
      let p = request.resource.data.participants;
      return p is list 
        && p.size() == 2 
        && p[0] is string 
        && p[1] is string 
        && p[0] != p[1] 
        && request.auth.uid in p;
    }

    // Verifies conversation participants cannot be modified after creation
    function areParticipantsUnchanged() {
      return request.resource.data.participants == resource.data.participants;
    }

    // Verifies if request user is a participant of an existing conversation
    function isConversationParticipant(convId) {
      return isAuthenticated() && 
        request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participants;
    }

    // Admins sign in with Google and have a doc at admins/{uid}, which can only be
    // created by hand in the Firebase Console. Anonymous accounts are never admins.
    function isAdmin() {
      return isAuthenticated()
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // A suspended account (suspensions/{uid}, see section 8) can still read and message
    // support, but can't match, chat, or post anywhere public.
    function isSuspended() {
      return exists(/databases/$(database)/documents/suspensions/$(request.auth.uid));
    }

    // Self-reported birthday stays private; this is an access gate, not identity verification.
    function isAgeEligible(userId) {
      let p = /databases/$(database)/documents/users/$(userId)/private/settings;
      return exists(p) && get(p).data.birthDate is timestamp
        && get(p).data.birthDate <= request.time - duration.value(6575, 'd');
    }
    function isProfileComplete(userId) {
      let p = /databases/$(database)/documents/users/$(userId)/public/profile;
      return exists(p) && get(p).data.get('profileComplete', false) == true;
    }
    function isEligibleMember(userId) { return isAgeEligible(userId) && isProfileComplete(userId); }

    // An admin moving an inbox item (suggestion or report) to another status. 'done' is the old single status and
    // stays valid so existing items and older admin pages keep working. A new item has no status (shown as New / Open).
    function isAdminStatusChange(allowed) {
      return isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in allowed;
    }

    function suggestionStatuses() {
      return ['open', 'reviewed', 'in_progress', 'implemented', 'archived', 'done'];
    }

    function reportStatuses() {
      return ['open', 'reviewing', 'resolved', 'dismissed', 'done'];
    }

    // Valid categories for community posts
    function isValidCategory(cat) {
      return cat in ['general', 'media', 'vents', 'friends', 'advice'];
    }

    // ====================================================
    // SLOW MODE (anti-spam)
    // ====================================================
    // rate_limits/{uid} remembers when a user last posted to each surface.
    // A post must stamp its field with request.time in the same batch, and is
    // only allowed if the previous stamp is at least `secs` seconds old.

    function rateLimitPath() {
      return /databases/$(database)/documents/rate_limits/$(request.auth.uid);
    }

    function slowMode(field, secs) {
      let before = exists(rateLimitPath()) ? get(rateLimitPath()).data : {};
      return getAfter(rateLimitPath()).data.get(field, null) == request.time
        && (!(field in before) || before[field] + duration.value(secs, 's') <= request.time);
    }

    match /rate_limits/{userId} {
      allow read: if isOwner(userId);
      // Only stamps of "now" can be written, so the clock can't be wound back.
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['publicRoom', 'unsaid', 'unsaidReply', 'suggestion', 'communityPost', 'communityReply', 'support', 'lookingForPost'])
        && (!('publicRoom' in request.resource.data.diff(resource == null ? {} : resource.data).affectedKeys())
            || request.resource.data.publicRoom == request.time)
        && (!('unsaid' in request.resource.data.diff(resource == null ? {} : resource.data).affectedKeys())
            || request.resource.data.unsaid == request.time)
        && (!('unsaidReply' in request.resource.data.diff(resource == null ? {} : resource.data).affectedKeys())
            || request.resource.data.unsaidReply == request.time)
        && (!('suggestion' in request.resource.data.diff(resource == null ? {} : resource.data).affectedKeys())
            || request.resource.data.suggestion == request.time)
        && (!('communityPost' in request.resource.data.diff(resource == null ? {} : resource.data).affectedKeys())
            || request.resource.data.communityPost == request.time)
        && (!('communityReply' in request.resource.data.diff(resource == null ? {} : resource.data).affectedKeys())
            || request.resource.data.communityReply == request.time)
        && (!('support' in request.resource.data.diff(resource == null ? {} : resource.data).affectedKeys())
            || request.resource.data.support == request.time)
        && (!('lookingForPost' in request.resource.data.diff(resource == null ? {} : resource.data).affectedKeys())
            || request.resource.data.lookingForPost == request.time);
      allow delete: if false;
    }

    match /admins/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    // ====================================================
    // 0. INDEXED COLLECTION GROUPS
    // ====================================================

    // Admin dashboard: counting members across users/{uid}/public/profile.
    match /{path=**}/public/{docId} {
      allow read: if isAdmin();
    }
    
    // Allow querying all public profiles across all users
    match /{path=**}/profile/{profileId} {
      allow read: if isAuthenticated() && resource.data.get('profileComplete', false) == true;
    }

    // ====================================================
    // 1. PRIVACY BY DESIGN: USER PROFILES & PRIVATE SETTINGS
    // ====================================================

    // Private settings (SOGIE, exact location, matching filters, blocked user IDs)
    // READABLE & WRITABLE ONLY BY PROFILE OWNER. ZERO PUBLIC EXPOSURE.
    match /users/{userId}/private/settings {
      allow read: if isOwner(userId);

      allow create: if isOwner(userId)
        && hasNoPrivilegedFields()
        && request.resource.data.keys().hasAll(['createdAt', 'updatedAt'])
        && request.resource.data.keys().hasOnly([
             'exactLocation', 'sexualOrientation', 'genderIdentity', 'genderExpression',
             'preferredGenderExpressions', 'birthDate', 'blockedPartnerIds', 'createdAt', 'updatedAt'
           ])
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && (!('birthDate' in request.resource.data)
            || (request.resource.data.birthDate is timestamp && request.resource.data.birthDate <= request.time - duration.value(6575, 'd')));

      allow update: if isOwner(userId)
        && hasNoPrivilegedFields()
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.keys().hasOnly([
             'exactLocation', 'sexualOrientation', 'genderIdentity', 'genderExpression', 
             'preferredGenderExpressions', 'birthDate', 'blockedPartnerIds', 'createdAt', 'updatedAt'
           ])
        && request.resource.data.updatedAt is timestamp
        && (!('birthDate' in request.resource.data)
            || (request.resource.data.birthDate is timestamp && request.resource.data.birthDate <= request.time - duration.value(6575, 'd')))
        // Once set, the birthday never changes from a client; corrections go through the reviewed API.
        && (!('birthDate' in resource.data) || request.resource.data.birthDate == resource.data.birthDate);

      allow delete: if false;
    }

    // Public Profile (displayName, pronouns, intention, region, topics)
    // READABLE BY ALL AUTHENTICATED USERS. WRITABLE ONLY BY OWNER.
    match /users/{userId}/public/profile {
      allow read: if isOwner(userId) || (isAuthenticated() && resource.data.get('profileComplete', false) == true);

      allow create, update: if isOwner(userId)
        && hasNoPrivilegedFields()
        && request.resource.data.keys().hasAll(['displayName', 'pronouns', 'intention', 'region', 'topics', 'updatedAt'])
        && request.resource.data.keys().hasOnly([
             'displayName', 'pronouns', 'intention', 'topics', 
             'region', 'showGenderExpressionOnProfile', 'showSexualOrientationOnProfile', 'showGenderIdentityOnProfile', 'showSogieOnProfile',
             'showLocationOnProfile', 'showAgeOnProfile', 'avatar', 'aboutMe', 'myVibe', 'personalStyle', 'sexualOrientation', 'genderIdentity', 'genderExpression', 'profileComplete', 'createdAt', 'updatedAt'
           ])
        // createdAt marks when someone joined: set once to "now", then never changed.
        && (resource != null && 'createdAt' in resource.data
            ? request.resource.data.createdAt == resource.data.createdAt
            : (!('createdAt' in request.resource.data) || request.resource.data.createdAt == request.time))
        && (!('avatar' in request.resource.data)
            || (request.resource.data.avatar is string && request.resource.data.avatar.size() <= 24))
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 1
        && request.resource.data.displayName.size() <= 30
        // A name can only be set or changed to the one /api/pseudonym reserved for this account (pseudonymOwners, which
        // clients cannot write). An unchanged name is never checked, so accounts whose names are not registered yet keep working.
        && ((resource != null && resource.data.get('displayName', null) == request.resource.data.displayName)
            || get(/databases/$(database)/documents/pseudonymOwners/$(userId)).data.name == request.resource.data.displayName)
        && request.resource.data.pronouns is string
        && request.resource.data.pronouns.size() >= 1
        && request.resource.data.pronouns.size() <= 20
        && request.resource.data.intention is string
        && request.resource.data.region is string
        && request.resource.data.topics is list
        && request.resource.data.topics.size() <= 8
        && (!('aboutMe' in request.resource.data) || (request.resource.data.aboutMe is string && request.resource.data.aboutMe.size() <= 160))
        && (!('myVibe' in request.resource.data) || (request.resource.data.myVibe is string && request.resource.data.myVibe.size() <= 24))
        && (!('personalStyle' in request.resource.data) || (request.resource.data.personalStyle is string && request.resource.data.personalStyle.size() <= 24))
        && (!('sexualOrientation' in request.resource.data) || (request.resource.data.sexualOrientation is string && request.resource.data.sexualOrientation.size() <= 40))
        && (!('genderIdentity' in request.resource.data) || (request.resource.data.genderIdentity is string && request.resource.data.genderIdentity.size() <= 40))
        && (!('genderExpression' in request.resource.data) || (request.resource.data.genderExpression is list && request.resource.data.genderExpression.size() <= 2))
        && (!('profileComplete' in request.resource.data) || request.resource.data.profileComplete is bool)
        && (!('showAgeOnProfile' in request.resource.data) || request.resource.data.showAgeOnProfile is bool)
        && request.resource.data.updatedAt is timestamp;

      allow delete: if false;
    }

    // ====================================================
    // 1b. LIVE MATCHMAKING QUEUE
    // ====================================================
    // match_queue/{uid}: a user's own "I'm looking for a chat" entry.
    // Only waiting entries are visible to others; matched entries are visible
    // to the owner and the person they were paired with.

    // Location, gender expression and topic filters: short lists of option names.
    function queueListValid(d, key) {
      return !(key in d) || (d[key] is list && d[key].size() >= 1 && d[key].size() <= 20);
    }

    function queueKeysValid() {
      return request.resource.data.keys().hasOnly([
               'status', 'partnerId', 'convId', 'createdAt', 'heartbeatAt', 'updatedAt',
               'areas', 'wantAreas', 'expr', 'wantExpr', 'topics', 'intent'
             ])
        && request.resource.data.status in ['waiting', 'matched']
        && queueListValid(request.resource.data, 'areas')
        && queueListValid(request.resource.data, 'wantAreas')
        && queueListValid(request.resource.data, 'expr')
        && queueListValid(request.resource.data, 'wantExpr')
        && queueListValid(request.resource.data, 'topics')
        && (!('intent' in request.resource.data)
            || request.resource.data.intent in ['friendship', 'dating', 'casual', 'deep_talk', 'open']);
    }

    function convHasParticipants(convId, a, b) {
      return convId is string
        && getAfter(/databases/$(database)/documents/conversations/$(convId)).data.participants.hasAll([a, b]);
    }

    match /match_queue/{userId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == userId
        || resource.data.status == 'waiting'
        || resource.data.partnerId == request.auth.uid
      );

      allow create: if isOwner(userId)
        && !isSuspended()
        && isEligibleMember(userId)
        && queueKeysValid()
        && request.resource.data.status == 'waiting'
        && request.resource.data.createdAt is timestamp
        && request.resource.data.heartbeatAt is timestamp;

      // Owner: heartbeat, reset to waiting, or mark self matched with a real conversation.
      allow update: if isOwner(userId)
        && isEligibleMember(userId)
        && queueKeysValid()
        && (request.resource.data.status == 'waiting'
            || convHasParticipants(request.resource.data.convId, userId, request.resource.data.partnerId));

      // Pairing is done only by the trusted matching API (private age ranges, eligibility, atomic claim).

      allow delete: if isOwner(userId);
    }

    // ====================================================
    // 2. 1-ON-1 CONVERSATIONS & EPHEMERAL MESSAGES
    // ====================================================

    // Typing indicator: conversations/{id}.typing is a map of uid -> server time. Each person may
    // only add, refresh or remove their own entry (removing = not typing).
    function typingChangeOk() {
      let after = request.resource.data.get('typing', {});
      let before = resource.data.get('typing', {});
      return after.diff(before).affectedKeys().hasOnly([request.auth.uid])
        && (!(request.auth.uid in after) || after[request.auth.uid] == request.time);
    }

    // Comfort Cards in Seek chat: a card message carries kind 'card', the card's id and, as its text, that card's approved question.
    // The rules hold the list, so nobody can send a card with words of their own. Keep it identical to COMFORT_CARDS in
    // api/_cards.js and src/utils/comfortCards.ts (a test checks that).
    function comfortCardQuestions() {
      return {
        "soft-01": "What is something small that made you smile today?",
        "soft-02": "What is your favorite way to spend a slow, cozy evening?",
        "soft-03": "What song makes you feel instantly warm?",
        "soft-04": "What is a comfort food that feels like a hug?",
        "soft-05": "What is the nicest compliment you have ever received?",
        "soft-06": "What does your perfect lazy Sunday look like?",
        "soft-07": "Which little everyday thing are you most grateful for lately?",
        "soft-08": "What is a scent that takes you somewhere happy?",
        "soft-09": "If you could send a warm hug to anyone right now, who would it be?",
        "soft-10": "What is your favorite kind of weather, and why?",
        "soft-11": "What small ritual makes your mornings better?",
        "soft-12": "What is something kind someone did for you that you still remember?",
        "know-01": "What are three things you could talk about for hours?",
        "know-02": "What is something you are really proud of that you rarely mention?",
        "know-03": "What do people usually get wrong about you at first?",
        "know-04": "What is a skill you would love to learn this year?",
        "know-05": "Are you a morning person, a night owl, or somewhere in between?",
        "know-06": "What was your favorite thing to do as a kid?",
        "know-07": "What is a hobby that makes you lose track of time?",
        "know-08": "Which book, show or game do you recommend to everyone?",
        "know-09": "What is a place you would love to visit one day?",
        "know-10": "What does a really good day look like for you?",
        "know-11": "What is something on your bucket list?",
        "know-12": "What are you looking forward to right now?",
        "deep-01": "What is something you have outgrown that you are glad to leave behind?",
        "deep-02": "When do you feel most like yourself?",
        "deep-03": "What is something you are still learning to accept about yourself?",
        "deep-04": "What is a lesson that took you a long time to learn?",
        "deep-05": "What does feeling safe with someone mean to you?",
        "deep-06": "What is a fear you have faced, even a little?",
        "deep-07": "What would you tell your younger self if you could?",
        "deep-08": "What does home mean to you?",
        "deep-09": "What is something you wish more people asked you about?",
        "deep-10": "How have you changed in the last few years?",
        "deep-11": "What makes a friendship feel real to you?",
        "deep-12": "What is one thing you hope never changes about you?",
        "love-01": "What does a love that feels safe and calm look like to you?",
        "love-02": "What is your idea of a perfect low-key date?",
        "love-03": "What is a green flag you always look for?",
        "love-04": "What is the smallest gesture that makes you feel cared for?",
        "love-05": "What do you love most about sapphic stories, songs or films?",
        "love-06": "How do you like to show someone you care?",
        "love-07": "What is your love language, and how did you find out?",
        "love-08": "What is something you want more of in your relationships?",
        "love-09": "What is a sweet memory of connecting with another woman?",
        "love-10": "What makes a connection feel like it could grow into something?",
        "love-11": "What does being seen and accepted by someone mean to you?",
        "love-12": "What is your favorite thing about the sapphic community?",
        "fun-01": "If your life had a theme song, what would it be?",
        "fun-02": "What is your most harmless unpopular opinion?",
        "fun-03": "Which fictional character do you secretly relate to?",
        "fun-04": "If you could have any superpower for a day, what would you pick?",
        "fun-05": "What is the most oddly specific thing that comforts you?",
        "fun-06": "What is your go-to karaoke song?",
        "fun-07": "Would you rather live by the sea or in the mountains?",
        "fun-08": "What is your current little obsession?",
        "fun-09": "What would your dream pet be called?",
        "fun-10": "If you opened a cafe, what would it be called and what would be on the menu?",
        "fun-11": "What is the best piece of random advice you have ever got?",
        "fun-12": "If you could instantly master one thing, what would it be?",
        "comfort-01": "What do you do when everything feels like too much?",
        "comfort-02": "What is one thing that always helps you feel calmer?",
        "comfort-03": "What is something you are working through right now, if you want to share?",
        "comfort-04": "What would feel like a kind thing to hear today?",
        "comfort-05": "What is one thing you are proud of yourself for this week?",
        "comfort-06": "Who or what makes you feel less alone?",
        "comfort-07": "What is a gentle thing you can do for yourself today?",
        "comfort-08": "What helps you through a tough day?",
        "comfort-09": "What is something you need less of in your life right now?",
        "comfort-10": "What is one small win you could celebrate today?",
        "comfort-11": "What is something you forgive yourself for?",
        "comfort-12": "What would you like someone to remind you of right now?"
      };
    }

    match /conversations/{convId} {
      // Admins can count conversations, but never read their messages.
      allow read: if isAuthenticated() && (request.auth.uid in resource.data.participants || isAdmin());

      // Created only by the trusted matching API.
      allow create: if false;

      // Status Transition Lock: 'ended' or 'blocked' conversations cannot be changed back to 'active'
      allow update: if isAuthenticated()
        && request.auth.uid in resource.data.participants
        && areParticipantsUnchanged()
        && resource.data.status == 'active'
        && request.resource.data.keys().hasOnly(['participants', 'createdAt', 'updatedAt', 'status', 'typing'])
        && request.resource.data.status in ['active', 'ended', 'blocked']
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt is timestamp
        && typingChangeOk();

      allow delete: if false;

      // A reply carries a short quote of the message it answers.
      function isValidReplyQuote(q) {
        return q is map
          && q.keys().hasAll(['id', 'text', 'senderId'])
          && q.keys().hasOnly(['id', 'text', 'senderId'])
          && q.id is string && q.id.size() >= 1 && q.id.size() <= 64
          && q.text is string && q.text.size() <= 140
          && q.senderId is string && q.senderId.size() <= 128;
      }

      // Ephemeral Chat Messages
      match /messages/{messageId} {
        allow read: if isConversationParticipant(convId);

        allow create: if isConversationParticipant(convId)
          && isEligibleMember(request.auth.uid)
          && !isSuspended()
          && request.resource.data.keys().hasAll(['senderId', 'text', 'timestamp'])
          && request.resource.data.keys().hasOnly(['senderId', 'text', 'timestamp', 'replyTo', 'kind', 'cardId'])
          && request.resource.data.senderId == request.auth.uid
          // A Comfort Card: kind 'card', a card id on the list, and exactly that card's question as the text. Nothing else carries them.
          && (!('kind' in request.resource.data)
              || (request.resource.data.kind == 'card'
                  && request.resource.data.keys().hasAll(['cardId'])
                  && comfortCardQuestions().get(request.resource.data.cardId, null) == request.resource.data.text))
          && (!('cardId' in request.resource.data) || request.resource.data.get('kind', null) == 'card')
          && (!('replyTo' in request.resource.data) || isValidReplyQuote(request.resource.data.replyTo))
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1
          && request.resource.data.text.size() <= 1000
          && request.resource.data.timestamp is timestamp;

        allow update, delete: if false; // Messages are immutable
      }
    }

    // ====================================================
    // 3. PUBLIC ROOM MESSAGES (TOWN SQUARE)
    // ====================================================

    function isValidRoomQuote(q) {
      return q is map
        && q.keys().hasAll(['id', 'author', 'text'])
        && q.keys().hasOnly(['id', 'author', 'text'])
        && q.id is string && q.id.size() >= 1 && q.id.size() <= 64
        && q.author is string && q.author.size() <= 30
        && q.text is string && q.text.size() <= 140;
    }

    // A member's reply must quote a message that really exists, under its real author, so nobody can
    // put words in another member's mouth. Originals up to 140 characters must match exactly; for longer
    // ones the quote is the first 140 characters (the client cuts it; its content cannot be checked here).
    function isGenuineRoomQuote(q) {
      return isValidRoomQuote(q)
        && !q.id.matches('.*/.*')
        && exists(roomMessagePath(q.id))
        && get(roomMessagePath(q.id)).data.authorName == q.author
        && (get(roomMessagePath(q.id)).data.text.size() > 140
            ? q.text.size() == 140
            : get(roomMessagePath(q.id)).data.text == q.text);
    }

    function roomMessagePath(messageId) {
      return /databases/$(database)/documents/public_room_messages/$(messageId);
    }

    function roomReactionPath(messageId) {
      return /databases/$(database)/documents/public_room_messages/$(messageId)/reactions/$(request.auth.uid);
    }

    // The mirror of bumpsOnly(): one counter goes down by one (never below zero).
    function dropsOnly(field) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([field])
        && request.resource.data[field] == resource.data.get(field, 0) - 1
        && request.resource.data[field] >= 0;
    }

    match /public_room_messages/{messageId} {
      allow read: if isAuthenticated();

      allow create: if isAuthenticated()
        && isEligibleMember(request.auth.uid)
        && request.resource.data.keys().hasAll(['authorId', 'authorName', 'authorPronouns', 'text', 'timestamp'])
        && request.resource.data.keys().hasOnly(['authorId', 'authorName', 'authorPronouns', 'authorAvatar', 'text', 'timestamp', 'replyTo'])
        && (!('replyTo' in request.resource.data) || isGenuineRoomQuote(request.resource.data.replyTo))
        && request.resource.data.authorId == request.auth.uid
        && (!('authorAvatar' in request.resource.data)
            || (request.resource.data.authorAvatar is string && request.resource.data.authorAvatar.size() <= 24))
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() >= 1
        && request.resource.data.authorName.size() <= 30
        && request.resource.data.authorPronouns is string
        && request.resource.data.authorPronouns.size() >= 1
        && request.resource.data.authorPronouns.size() <= 20
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 1000
        && request.resource.data.timestamp == request.time
        && slowMode('publicRoom', 2)
        && !isSuspended();

      // Team announcements: only admins can post with the verified team flag (no slow mode),
      // optionally quoting the message they answer.
      allow create: if isAdmin()
        && request.resource.data.keys().hasAll(['authorId', 'authorName', 'authorPronouns', 'text', 'timestamp', 'team'])
        && request.resource.data.keys().hasOnly(['authorId', 'authorName', 'authorPronouns', 'text', 'timestamp', 'team', 'replyTo'])
        && (!('replyTo' in request.resource.data) || isValidRoomQuote(request.resource.data.replyTo))
        && request.resource.data.team == true
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() <= 30
        && request.resource.data.authorPronouns is string
        && request.resource.data.authorPronouns.size() <= 20
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 1000
        && request.resource.data.timestamp == request.time;

      // Messages never change, except for reaction counters: +1 on one counter alongside a new
      // reactions/{uid} marker of that type (one reaction per person), or -1 when removing it.
      // Counters start missing (counted as 0). Keep the types in sync with ROOM_REACTIONS.
      allow update: if isAuthenticated()
        && isEligibleMember(request.auth.uid)
        && !isSuspended()
        && (bumpsOnly('heart') || bumpsOnly('laugh') || bumpsOnly('hug') || bumpsOnly('fire') || bumpsOnly('cry'))
        && !exists(roomReactionPath(messageId))
        && getAfter(roomReactionPath(messageId)).data.type in request.resource.data.diff(resource.data).affectedKeys();
      allow update: if isAuthenticated()
        && isEligibleMember(request.auth.uid)
        && (dropsOnly('heart') || dropsOnly('laugh') || dropsOnly('hug') || dropsOnly('fire') || dropsOnly('cry'))
        && get(roomReactionPath(messageId)).data.type in request.resource.data.diff(resource.data).affectedKeys()
        && !existsAfter(roomReactionPath(messageId));

      match /reactions/{userId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && isEligibleMember(request.auth.uid)
          && request.resource.data.keys().hasOnly(['type', 'createdAt'])
          && request.resource.data.type in ['heart', 'laugh', 'hug', 'fire', 'cry']
          && request.resource.data.createdAt == request.time
          && getAfter(roomMessagePath(messageId)).data[request.resource.data.type]
               == get(roomMessagePath(messageId)).data.get(request.resource.data.type, 0) + 1;
        allow delete: if isOwner(userId)
          && isEligibleMember(request.auth.uid)
          && getAfter(roomMessagePath(messageId)).data.get(resource.data.type, 0)
               == get(roomMessagePath(messageId)).data.get(resource.data.type, 0) - 1;
        allow update: if false;
      }

      allow delete: if isAdmin();
    }

    // ====================================================
    // 4. COMMUNITY POSTS, LIKES & REPLIES
    // ====================================================
    // Posts are shared with everyone. Like and reply counters live on the post and
    // can only move by one, together with the matching likes/{uid} or replies/{id}
    // doc in the same batch, so each person likes once and counts can't be faked.

    function postPath(postId) {
      return /databases/$(database)/documents/community_posts/$(postId);
    }

    function validAuthorFields(data) {
      return data.authorId == request.auth.uid
        && data.authorName is string
        && data.authorName.size() >= 1
        && data.authorName.size() <= 30
        && data.authorPronouns is string
        && data.authorPronouns.size() <= 20
        && (!('authorAvatar' in data) || (data.authorAvatar is string && data.authorAvatar.size() <= 24));
    }

    function counterMoves(field, by) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([field])
        && request.resource.data[field] == resource.data[field] + by;
    }

    match /community_posts/{postId} {
      allow read: if isAuthenticated();

      allow create: if isAuthenticated()
        && isEligibleMember(request.auth.uid)
        && request.resource.data.keys().hasAll(['authorId', 'authorName', 'authorPronouns', 'title', 'content', 'category', 'tags', 'likes', 'replyCount', 'timestamp'])
        && request.resource.data.keys().hasOnly(['authorId', 'authorName', 'authorPronouns', 'authorAvatar', 'title', 'content', 'category', 'tags', 'likes', 'replyCount', 'timestamp'])
        && validAuthorFields(request.resource.data)
        && isValidCategory(request.resource.data.category)
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 1
        && request.resource.data.title.size() <= 90
        && request.resource.data.content is string
        && request.resource.data.content.size() >= 1
        && request.resource.data.content.size() <= 1000
        && request.resource.data.tags is list
        && request.resource.data.tags.size() <= 4
        && request.resource.data.likes == 0
        && request.resource.data.replyCount == 0
        && request.resource.data.timestamp == request.time
        && slowMode('communityPost', 30)
        && !isSuspended();

      // Appreciation is Stardust (stardustCount and the stardust/{uid} docs), written only by /api/stardust with the Admin SDK.
      // No client update may touch stardustCount: every rule below moves exactly one named counter (counterMoves).
      // Reply: +1, written in the same batch as the reply (checked on the reply doc).
      allow update: if isAuthenticated() && isEligibleMember(request.auth.uid) && counterMoves('replyCount', 1) && slowMode('communityReply', 5);
      // Admin removing a reply: -1.
      allow update: if isAdmin() && counterMoves('replyCount', -1);

      allow delete: if isAuthenticated() && (request.auth.uid == resource.data.authorId || isAdmin());

      // Legacy likes: kept as history after the move to Stardust (scripts/migrate-stardust.mjs reads them). Nobody can add or
      // remove one any more; admins can still clear them once the post is gone.
      match /likes/{userId} {
        allow read: if isOwner(userId) || isAdmin();
        allow delete: if isAdmin() && !exists(postPath(postId));
        allow create, update: if false;
      }

      // Stardust reactions: server-written only. A member can read their own; admins can read and, once the post is gone,
      // clear them. Who gave Stardust is never visible to other members.
      match /stardust/{userId} {
        allow read: if isOwner(userId) || isAdmin();
        allow delete: if isAdmin() && !exists(postPath(postId));
        allow create, update: if false;
      }

      match /replies/{replyId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated()
          && isEligibleMember(request.auth.uid)
          && request.resource.data.keys().hasAll(['authorId', 'authorName', 'authorPronouns', 'content', 'timestamp'])
          && request.resource.data.keys().hasOnly(['authorId', 'authorName', 'authorPronouns', 'authorAvatar', 'content', 'timestamp'])
          && validAuthorFields(request.resource.data)
          && request.resource.data.content is string
          && request.resource.data.content.size() >= 1
          && request.resource.data.content.size() <= 500
          && request.resource.data.timestamp == request.time
          && getAfter(postPath(postId)).data.replyCount == get(postPath(postId)).data.replyCount + 1
          && slowMode('communityReply', 5)
          && !isSuspended();
        allow delete: if isAdmin()
          && getAfter(postPath(postId)).data.replyCount == get(postPath(postId)).data.replyCount - 1;
        allow update: if false;
      }
    }

    // ====================================================
    // 4b. COSMOS "LOOKING FOR" BOARD (adult connection posts)
    // ====================================================
    // Kept apart from community_posts. Only adult members with a saved profile can read or write here, checked
    // from the private birthday (never from anything the client sends). A post's id is "{uid}_{intention}", so a
    // member has at most one post per intention (five in total) and posting again edits that one. An age shown on a
    // post must match the private birthday. Contacting the author goes through Signals (api/signals.js), which
    // re-checks age, blocks and suspensions on the server.

    function lookingForIntentions() {
      return ['dating', 'friendship', 'talk', 'gaming', 'open', 'nsfw'];
    }

    function lookingForPath(postId) {
      return /databases/$(database)/documents/looking_for_posts/$(postId);
    }

    // An age is only believable if the private birthday puts the member in that year of life (a few days of slack
    // for leap years). Posts that show no age skip this.
    function lookingForAgeMatches(age) {
      let p = /databases/$(database)/documents/users/$(request.auth.uid)/private/settings;
      return age is int && age >= 18 && age <= 99
        && exists(p) && get(p).data.birthDate is timestamp
        && get(p).data.birthDate <= request.time - duration.value(age * 365, 'd')
        && get(p).data.birthDate > request.time - duration.value((age + 1) * 366, 'd');
    }

    function lookingForFlairs() {
      return ['Masc × Femme', 'Masc × Masc', 'Masc × Any', 'Femme × Masc', 'Femme × Femme', 'Femme × Any',
              'Andro × Masc', 'Andro × Femme', 'Andro × Any', 'Trans Femme × Masc', 'Trans Femme × Femme', 'Trans Femme × Any', 'All WLW'];
    }

    // "About me" and "About you": at least 100 characters, and stored already trimmed so the count is of real text.
    function lookingForSection(text) {
      return text is string && text.size() >= 100 && text.matches('^\\S[\\s\\S]*\\S$');
    }

    function validLookingForBody(data) {
      return validAuthorFields(data)
        && (!('flair' in data) || data.flair in lookingForFlairs())
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 90
        && data.intro is string && data.intro.size() >= 1 && data.intro.size() <= 400
        && data.lookingFor is string && data.lookingFor.size() >= 1 && data.lookingFor.size() <= 400
        && data.intention in lookingForIntentions()
        && data.tags is list && data.tags.size() <= 6
        && data.isNsfw is bool
        // NSFW Connection posts are always mature, so they are always concealed on the board.
        && (data.intention != 'nsfw' || data.isNsfw == true)
        && (data.isNsfw
              ? (data.contentWarning == null || (data.contentWarning is string && data.contentWarning.size() <= 120))
              : data.contentWarning == null)
        && (!('age' in data) || lookingForAgeMatches(data.age))
        && (!('seekAgeMin' in data) || (data.seekAgeMin is int && data.seekAgeMin >= 18 && data.seekAgeMin <= 99))
        && (!('seekAgeMax' in data) || (data.seekAgeMax is int && data.seekAgeMax >= 18 && data.seekAgeMax <= 99))
        && (!('seekAgeMin' in data && 'seekAgeMax' in data) || data.seekAgeMin <= data.seekAgeMax)
        && (!('region' in data) || (data.region is string && data.region.size() >= 1 && data.region.size() <= 60))
        && (!('requestsPaused' in data) || data.requestsPaused is bool);
    }

    match /looking_for_posts/{postId} {
      allow read: if isAuthenticated() && isEligibleMember(request.auth.uid);

      allow create: if isAuthenticated()
        && isEligibleMember(request.auth.uid)
        && !isSuspended()
        && postId == request.auth.uid + '_' + request.resource.data.intention
        && request.resource.data.keys().hasAll(['authorId', 'authorName', 'authorPronouns', 'title', 'intro', 'lookingFor', 'intention', 'age', 'flair', 'tags', 'isNsfw', 'contentWarning', 'timestamp'])
        && request.resource.data.keys().hasOnly(['authorId', 'authorName', 'authorPronouns', 'authorAvatar', 'title', 'intro', 'lookingFor', 'intention', 'age', 'flair', 'seekAgeMin', 'seekAgeMax', 'region', 'tags', 'isNsfw', 'contentWarning', 'requestsPaused', 'timestamp', 'updatedAt'])
        && validLookingForBody(request.resource.data)
        && lookingForSection(request.resource.data.intro)
        && lookingForSection(request.resource.data.lookingFor)
        && request.resource.data.timestamp == request.time
        && slowMode('lookingForPost', 60);

      // The author edits their own post: identity, intention and first-posted time never change.
      allow update: if isAuthenticated()
        && request.auth.uid == resource.data.authorId
        && isEligibleMember(request.auth.uid)
        && !isSuspended()
        && request.resource.data.keys().hasAll(['authorId', 'authorName', 'authorPronouns', 'title', 'intro', 'lookingFor', 'intention', 'tags', 'isNsfw', 'contentWarning', 'timestamp', 'updatedAt'])
        // stardustCount is server-managed: it may be present on the post (so an edit still passes), but an edit can never change it.
        && request.resource.data.keys().hasOnly(['authorId', 'authorName', 'authorPronouns', 'authorAvatar', 'title', 'intro', 'lookingFor', 'intention', 'age', 'flair', 'seekAgeMin', 'seekAgeMax', 'region', 'tags', 'isNsfw', 'contentWarning', 'requestsPaused', 'timestamp', 'updatedAt', 'stardustCount'])
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['stardustCount'])
        // An edit must carry an age and a flair; a post from before flairs can still be paused or resumed as it is.
        && (('age' in request.resource.data && 'flair' in request.resource.data)
            || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['requestsPaused', 'updatedAt']))
        // A section the edit changes must meet the minimum; an older, shorter one can stay as it is (pause, resume, retitle).
        && (request.resource.data.intro == resource.data.intro || lookingForSection(request.resource.data.intro))
        && (request.resource.data.lookingFor == resource.data.lookingFor || lookingForSection(request.resource.data.lookingFor))
        && request.resource.data.authorId == resource.data.authorId
        && request.resource.data.intention == resource.data.intention
        && request.resource.data.timestamp == resource.data.timestamp
        && request.resource.data.updatedAt == request.time
        && validLookingForBody(request.resource.data);

      allow delete: if isAuthenticated() && (request.auth.uid == resource.data.authorId || isAdmin());

      // Stardust reactions: same shape and rules as on community posts. Written only by /api/stardust.
      match /stardust/{userId} {
        allow read: if isOwner(userId) || isAdmin();
        allow delete: if isAdmin() && !exists(/databases/$(database)/documents/looking_for_posts/$(postId));
        allow create, update: if false;
      }
    }

    // ====================================================
    // 4b. STARDUST TOTALS (SERVER-MANAGED)
    // ====================================================
    // One document per author: their single Stardust total across Community and Looking For posts. It shows on public profiles,
    // so any signed-in member can read it; only /api/stardust (Admin SDK) and the migration script ever write it.
    match /stardust_totals/{authorId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // ====================================================
    // 4c. CONNECTION REQUESTS (SERVER-MANAGED)
    // ====================================================
    // A request asks the author of a Looking For post for permission to start a private Signals conversation. Requests,
    // their duplicate-prevention locks and their audit trail are written only by the Signals API (Admin SDK), which
    // validates every status change. Clients can read none of them: the API returns a member only their own requests.
    // Admins can read the audit trail, so moderation can see what happened; members never can.
    match /connection_requests/{requestId} {
      allow read, write: if false;
    }

    match /connection_request_locks/{lockId} {
      allow read, write: if false;
    }

    match /connection_request_events/{eventId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ====================================================
    // 5. ABUSE & SAFETY REPORTS
    // ====================================================

    match /reports/{reportId} {
      allow create: if isAuthenticated()
        && request.resource.data.keys().hasAll(['reporterId', 'targetId', 'targetType', 'reason', 'timestamp'])
        && request.resource.data.keys().hasOnly(['reporterId', 'targetId', 'targetType', 'reason', 'timestamp'])
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.targetId is string
        && request.resource.data.targetType in ['user', 'message', 'post']
        && request.resource.data.reason is string
        && request.resource.data.reason.size() >= 1
        && request.resource.data.reason.size() <= 300
        && request.resource.data.timestamp is timestamp;

      // Only admins can read reports; reporters can't see each other's.
      allow read, delete: if isAdmin();
      allow update: if isAdminStatusChange(reportStatuses());
    }

    // An admin lets a member whose birthday locked them out (an age-review report) try the birthday step once more. It only
    // brings the form back: access still depends on a saved adult birthday (isAgeEligible), which the member's own device
    // writes and the rules check. The member consumes the clearance (deletes it) the moment it is used, so one clearance is
    // one retry. Nobody lists them.
    match /age_review_clearances/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasAll(['clearedBy', 'clearedAt'])
        && request.resource.data.keys().hasOnly(['clearedBy', 'clearedAt', 'reportId'])
        && request.resource.data.clearedBy == request.auth.uid
        && request.resource.data.clearedAt == request.time
        && (!('reportId' in request.resource.data) || (request.resource.data.reportId is string && request.resource.data.reportId.size() <= 128));
      allow delete: if isOwner(userId) || isAdmin();
    }

    // ====================================================
    // 5b. ECHOES / UNSAID WALL (anonymous; stays until the author deletes it or moderation removes it)
    // ====================================================
    // Posts carry no author field. Ownership lives in unsaid_owners/{postId},
    // readable only by the author, so nobody can link a post to a profile.
    // Reaction and flag counters can only go up by one, together with a
    // per-user marker document, so each person counts once.

    function unsaidPath(postId) {
      return /databases/$(database)/documents/unsaid/$(postId);
    }

    function unsaidOwnerPath(postId) {
      return /databases/$(database)/documents/unsaid_owners/$(postId);
    }

    function bumpsOnly(field) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([field])
        && request.resource.data[field] == resource.data.get(field, 0) + 1;
    }

    // The eight Echoes categories (Release: confession, vent, unsent. Connect: advice, thoughts. Uplift: wins, gratitude,
    // daydreams). Keep in step with UNSAID_KINDS in src/utils/echoKinds.ts; a test checks that they match.
    function unsaidKinds() {
      return ['confession', 'vent', 'unsent', 'advice', 'thoughts', 'wins', 'gratitude', 'daydreams'];
    }

    // Replies exist ONLY for Need Advice, Random Thoughts and the three Uplift categories. Confession, Vent and Unsent Letters
    // are reactions only: no rule below lets a reply, or a reply counter, exist on them, whatever the app shows.
    function unsaidReplyKinds() {
      return ['advice', 'thoughts', 'wins', 'gratitude', 'daydreams'];
    }

    // Optional mood tags on an Echo (metadata, not categories). Keep in step with MOODS in src/utils/echoMoods.ts.
    function unsaidMoods() {
      return ['vulnerable', 'melancholic', 'overwhelmed', 'healing', 'lonely', 'reflective', 'hopeful', 'happy', 'grateful', 'growing', 'loved', 'proud',
              'in-love', 'crushing', 'missing-someone', 'dreaming', 'connected', 'longing', 'daydreaming', 'confused', 'silly', 'chill', 'excited', 'feeling-myself'];
    }

    function unsaidReplyPath(postId, replyId) {
      return /databases/$(database)/documents/unsaid/$(postId)/replies/$(replyId);
    }

    // Who wrote a reply, readable only by that member. The reply itself carries no author, like a post.
    function unsaidReplyOwnerPath(replyId) {
      return /databases/$(database)/documents/unsaid_reply_owners/$(replyId);
    }

    // A reply id is a Firestore auto id (letters, digits, - and _).
    function validReplyId(id) {
      return id is string && id.matches('^[A-Za-z0-9_-]{8,64}$');
    }

    match /unsaid/{postId} {
      allow read: if isAuthenticated();

      allow create: if isAuthenticated()
        && isEligibleMember(request.auth.uid)
        && request.resource.data.keys().hasAll(['kind', 'text', 'createdAt', 'hugs', 'same', 'flags'])
        && request.resource.data.keys().hasOnly(['kind', 'text', 'createdAt', 'expiresAt', 'hugs', 'same', 'flags', 'replyCount', 'moodTags'])
        && request.resource.data.kind in unsaidKinds()
        // Only a category that takes replies may carry a reply counter, and it starts at zero.
        && (!('replyCount' in request.resource.data)
            || (request.resource.data.replyCount == 0 && request.resource.data.kind in unsaidReplyKinds()))
        // Mood tags are optional: one or two, all from the approved list, never the same one twice.
        && (!('moodTags' in request.resource.data)
            || (request.resource.data.moodTags is list
                && request.resource.data.moodTags.size() >= 1
                && request.resource.data.moodTags.size() <= 2
                && request.resource.data.moodTags.hasOnly(unsaidMoods())
                && (request.resource.data.moodTags.size() == 1
                    || request.resource.data.moodTags[0] != request.resource.data.moodTags[1])))
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 500
        && request.resource.data.createdAt == request.time
        // Echoes no longer expire. Older app versions still send a 48-hour expiresAt, which stays accepted and honoured.
        && (!('expiresAt' in request.resource.data)
            || (request.resource.data.expiresAt is timestamp
                && request.resource.data.expiresAt > request.time + duration.value(47, 'h')
                && request.resource.data.expiresAt < request.time + duration.value(49, 'h')))
        && request.resource.data.hugs == 0
        && request.resource.data.same == 0
        && request.resource.data.flags == 0
        && getAfter(unsaidOwnerPath(postId)).data.authorId == request.auth.uid
        && slowMode('unsaid', 60)
        && !isSuspended();

      // A reaction: +1 on one reaction counter alongside a new reactions/{uid} doc of that type.
      // Counters added after launch (felt, strong, proud, cry) start missing and count from 0.
      allow update: if isAuthenticated()
        && isEligibleMember(request.auth.uid)
        && (bumpsOnly('hugs') || bumpsOnly('same') || bumpsOnly('felt') || bumpsOnly('strong') || bumpsOnly('proud')
            || bumpsOnly('cry'))
        && !exists(/databases/$(database)/documents/unsaid/$(postId)/reactions/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/unsaid/$(postId)/reactions/$(request.auth.uid)).data.type
             in request.resource.data.diff(resource.data).affectedKeys();

      // A flag: +1 on 'flags' alongside a new flags/{uid} doc.
      allow update: if isAuthenticated()
        && isEligibleMember(request.auth.uid)
        && bumpsOnly('flags')
        && !exists(/databases/$(database)/documents/unsaid/$(postId)/flags/$(request.auth.uid))
        && existsAfter(/databases/$(database)/documents/unsaid/$(postId)/flags/$(request.auth.uid));

      // Admin restore: clear the flags on a post that was wrongly hidden.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['flags'])
        && request.resource.data.flags == 0;

      // A reply (Need Advice and Uplift only): replyCount +1, in the same batch as the reply itself, its private owner record and
      // the member's slow-mode stamp. `lastReply` names the reply, so the counter cannot move without a real, new reply.
      allow update: if isAuthenticated()
        && isEligibleMember(request.auth.uid)
        && !isSuspended()
        && resource.data.kind in unsaidReplyKinds()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['replyCount', 'lastReply'])
        && request.resource.data.replyCount == resource.data.get('replyCount', 0) + 1
        && validReplyId(request.resource.data.lastReply)
        && !exists(unsaidReplyPath(postId, request.resource.data.lastReply))
        && existsAfter(unsaidReplyPath(postId, request.resource.data.lastReply))
        && getAfter(unsaidReplyOwnerPath(request.resource.data.lastReply)).data.authorId == request.auth.uid
        && slowMode('unsaidReply', 5);

      // Taking a reply back: replyCount -1, in the same batch that deletes that reply and its owner record. Only the member who
      // wrote it (the owner record says so) can do this, or a moderator.
      allow update: if isAuthenticated()
        && resource.data.kind in unsaidReplyKinds()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['replyCount', 'lastReply'])
        && resource.data.get('replyCount', 0) > 0
        && request.resource.data.replyCount == resource.data.get('replyCount', 0) - 1
        && validReplyId(request.resource.data.lastReply)
        && exists(unsaidReplyPath(postId, request.resource.data.lastReply))
        && !existsAfter(unsaidReplyPath(postId, request.resource.data.lastReply))
        && (isAdmin()
            || (get(unsaidReplyOwnerPath(request.resource.data.lastReply)).data.authorId == request.auth.uid
                && !existsAfter(unsaidReplyOwnerPath(request.resource.data.lastReply))));

      allow delete: if isAuthenticated()
        && (get(unsaidOwnerPath(postId)).data.authorId == request.auth.uid || isAdmin());

      // Replies: Need Advice and the Uplift categories only. Anyone signed in can read them; each one is anonymous.
      match /replies/{replyId} {
        allow read: if isAuthenticated();

        // Created only together with the post's counter going up by one (checked by the post rule above, which also requires an
        // adult member who is not suspended and the slow-mode stamp), so everything a reply needs is enforced there and here.
        allow create: if isAuthenticated()
          && validReplyId(replyId)
          && get(unsaidPath(postId)).data.kind in unsaidReplyKinds()
          && request.resource.data.keys().hasAll(['text', 'createdAt'])
          && request.resource.data.keys().hasOnly(['text', 'createdAt'])
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1
          && request.resource.data.text.size() <= 300
          && request.resource.data.createdAt == request.time
          && getAfter(unsaidPath(postId)).data.get('replyCount', 0) == get(unsaidPath(postId)).data.get('replyCount', 0) + 1
          && getAfter(unsaidPath(postId)).data.lastReply == replyId
          && getAfter(unsaidReplyOwnerPath(replyId)).data.authorId == request.auth.uid;

        // Deleted only together with the counter going down by one (whose rule says who may: the author of the reply, or a moderator).
        allow delete: if isAuthenticated()
          && getAfter(unsaidPath(postId)).data.get('replyCount', 0) == get(unsaidPath(postId)).data.get('replyCount', 0) - 1
          && getAfter(unsaidPath(postId)).data.lastReply == replyId;

        allow update: if false;
      }

      match /reactions/{userId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && isEligibleMember(request.auth.uid)
          && request.resource.data.keys().hasOnly(['type', 'createdAt'])
          && request.resource.data.type in ['hugs', 'same', 'felt', 'strong', 'proud', 'cry']
          && request.resource.data.createdAt == request.time
          && getAfter(unsaidPath(postId)).data[request.resource.data.type]
               == get(unsaidPath(postId)).data.get(request.resource.data.type, 0) + 1;
        allow update, delete: if false;
      }

      match /flags/{userId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.keys().hasOnly(['createdAt'])
          && request.resource.data.createdAt == request.time
          && getAfter(unsaidPath(postId)).data.flags == get(unsaidPath(postId)).data.flags + 1;
        allow update, delete: if false;
      }
    }

    match /unsaid_owners/{postId} {
      allow read: if isAuthenticated() && resource.data.authorId == request.auth.uid;

      // Only for a brand-new post, created in the same batch. A post that takes replies also records its kind (which must be the
      // post's own) and a "replies seen" counter at zero; that is how its author is told about new replies, privately.
      allow create: if isAuthenticated()
        && request.resource.data.keys().hasAll(['authorId'])
        && request.resource.data.keys().hasOnly(['authorId', 'kind', 'seenReplies'])
        && request.resource.data.authorId == request.auth.uid
        && (!('kind' in request.resource.data) || request.resource.data.kind == getAfter(unsaidPath(postId)).data.kind)
        && (!('seenReplies' in request.resource.data) || request.resource.data.seenReplies == 0)
        && !exists(unsaidPath(postId))
        && existsAfter(unsaidPath(postId));

      // Admins can clean up the owner record when removing a post, but still can't read it.
      allow delete: if isAuthenticated()
        && (resource.data.authorId == request.auth.uid || isAdmin())
        && !existsAfter(unsaidPath(postId));

      // The author marking replies as seen. Nothing else about the record can change, and it cannot exceed the real count.
      allow update: if isAuthenticated()
        && resource.data.authorId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seenReplies'])
        && request.resource.data.seenReplies is int
        && request.resource.data.seenReplies >= 0
        && request.resource.data.seenReplies <= get(unsaidPath(postId)).data.get('replyCount', 0);
    }

    // Who wrote each reply, private to that member, exactly like unsaid_owners for posts. Not even the post's author can read it,
    // so a reply can never be traced to a person. Created with its reply, deleted with it.
    match /unsaid_reply_owners/{replyId} {
      allow read: if isAuthenticated() && resource.data.authorId == request.auth.uid;

      allow create: if isAuthenticated()
        && request.resource.data.keys().hasAll(['authorId', 'postId'])
        && request.resource.data.keys().hasOnly(['authorId', 'postId'])
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.postId is string
        && validReplyId(replyId)
        && !exists(unsaidReplyOwnerPath(replyId))
        && existsAfter(unsaidReplyPath(request.resource.data.postId, replyId));

      // A moderator can clean the record up when removing a reply, but still cannot read it.
      allow delete: if isAuthenticated()
        && (resource.data.authorId == request.auth.uid || isAdmin())
        && !existsAfter(unsaidReplyPath(resource.data.postId, replyId));

      allow update: if false;
    }

    // ====================================================
    // 5c. ECHO NOTIFICATIONS (private to the author of an Echo)
    // ====================================================
    // echo_notifications/{uid}            the member's two on/off settings (replies, milestones).
    // echo_notifications/{uid}/items/{id} one notification each. Only that member can read them, and only that member's own
    // device creates them (it is the one device that knows which Echoes are theirs): each is checked against the real data, so
    // it cannot be made up. Its id comes from the event, so one event can only ever have one notification. Nothing in it names
    // a replier or a reactor. Not deletable, which also keeps an event from being announced twice.

    function reactionTotalOf(p) {
      return p.get('hugs', 0) + p.get('same', 0) + p.get('felt', 0) + p.get('strong', 0) + p.get('proud', 0) + p.get('cry', 0);
    }

    match /echo_notifications/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasAll(['replies', 'milestones'])
        && request.resource.data.keys().hasOnly(['replies', 'milestones'])
        && request.resource.data.replies is bool
        && request.resource.data.milestones is bool;

      match /items/{notificationId} {
        allow read: if isOwner(userId);

        allow create: if isOwner(userId)
          && isEligibleMember(userId)
          && request.resource.data.keys().hasAll(['type', 'postId', 'kind', 'createdAt', 'read'])
          && request.resource.data.keys().hasOnly(['type', 'postId', 'kind', 'replyId', 'preview', 'eventAt', 'threshold', 'createdAt', 'read'])
          && request.resource.data.read == false
          && request.resource.data.createdAt == request.time
          && request.resource.data.postId is string
          && request.resource.data.postId.matches('^[A-Za-z0-9_-]{1,64}$')
          // It is about one of the writer's own Echoes, and says that Echo's real category.
          && exists(unsaidPath(request.resource.data.postId))
          && get(unsaidOwnerPath(request.resource.data.postId)).data.authorId == userId
          && request.resource.data.kind == get(unsaidPath(request.resource.data.postId)).data.kind
          && (
            // A reply: only on a category that takes replies, a reply that exists, not one the writer wrote themselves.
            (request.resource.data.type == 'reply'
              && request.resource.data.keys().hasAll(['replyId', 'preview', 'eventAt'])
              && !('threshold' in request.resource.data)
              && request.resource.data.kind in unsaidReplyKinds()
              && validReplyId(request.resource.data.replyId)
              && notificationId == 'reply_' + request.resource.data.replyId
              && exists(unsaidReplyPath(request.resource.data.postId, request.resource.data.replyId))
              && get(unsaidReplyPath(request.resource.data.postId, request.resource.data.replyId)).data.createdAt == request.resource.data.eventAt
              && get(unsaidReplyOwnerPath(request.resource.data.replyId)).data.authorId != userId
              && request.resource.data.preview is string
              && request.resource.data.preview.size() <= 90)
            // A milestone: total reactions really have reached 10, 25, 50 or 100.
            || (request.resource.data.type == 'milestone'
              && request.resource.data.keys().hasAll(['threshold'])
              && !('replyId' in request.resource.data)
              && !('preview' in request.resource.data)
              && !('eventAt' in request.resource.data)
              && request.resource.data.threshold in [10, 25, 50, 100]
              && notificationId == 'milestone_' + request.resource.data.postId + '_' + string(request.resource.data.threshold)
              && reactionTotalOf(get(unsaidPath(request.resource.data.postId)).data) >= request.resource.data.threshold)
          );

        // Reading one: only the read flag, only to true.
        allow update: if isOwner(userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
          && request.resource.data.read == true;

        allow delete: if false;
      }
    }

    // ====================================================
    // 6. SUGGESTIONS & FEEDBACK
    // ====================================================
    // Write-only for users; admins read them on the /admin page.

    match /suggestions/{suggestionId} {
      allow create: if isAuthenticated()
        && request.resource.data.keys().hasAll(['authorId', 'category', 'text', 'createdAt'])
        && request.resource.data.keys().hasOnly(['authorId', 'category', 'text', 'createdAt'])
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.category in ['idea', 'bug', 'safety', 'other']
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 3
        && request.resource.data.text.size() <= 1000
        && request.resource.data.createdAt == request.time
        && slowMode('suggestion', 30);

      allow read, delete: if isAdmin();
      allow update: if isAdminStatusChange(suggestionStatuses());
    }

    // ====================================================
    // 7. SUPPORT CHAT
    // ====================================================
    // One private thread per member (support_threads/{uid}), visible only to that member
    // and admins. The thread doc is a summary for the admin inbox; messages hold the chat.

    function supportSummaryValid() {
      let d = request.resource.data;
      return d.keys().hasOnly(['displayName', 'avatar', 'lastMessage', 'lastFrom', 'updatedAt', 'unreadForTeam', 'unreadForUser'])
        && d.lastMessage is string && d.lastMessage.size() <= 140
        && (!('displayName' in d) || (d.displayName is string && d.displayName.size() <= 30))
        && (!('avatar' in d) || (d.avatar is string && d.avatar.size() <= 24));
    }

    function supportChanged() {
      return request.resource.data.diff(resource == null ? {} : resource.data).affectedKeys();
    }

    match /support_threads/{userId} {
      allow read: if isOwner(userId) || isAdmin();

      // Member sends: summary says the member wrote last, stamped with their slow mode.
      allow create, update: if isOwner(userId)
        && supportSummaryValid()
        && request.resource.data.lastFrom == 'user'
        && request.resource.data.unreadForTeam == true
        && request.resource.data.updatedAt == request.time
        && !('unreadForUser' in supportChanged())
        && slowMode('support', 2);

      // Member opens the chat: clear their unread flag only.
      allow update: if isOwner(userId)
        && supportChanged().hasOnly(['unreadForUser'])
        && request.resource.data.unreadForUser == false;

      // Team replies, or opens the thread (clears the team's unread flag only).
      allow update: if isAdmin() && supportSummaryValid() && (
        (supportChanged().hasOnly(['lastMessage', 'lastFrom', 'updatedAt', 'unreadForUser', 'unreadForTeam'])
          && request.resource.data.lastFrom == 'team'
          && request.resource.data.unreadForUser == true
          && request.resource.data.updatedAt == request.time)
        || (supportChanged().hasOnly(['unreadForTeam']) && request.resource.data.unreadForTeam == false)
      );

      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isOwner(userId) || isAdmin();

        allow create: if request.resource.data.keys().hasAll(['from', 'text', 'timestamp'])
          && request.resource.data.keys().hasOnly(['from', 'text', 'timestamp'])
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1
          && request.resource.data.text.size() <= 1000
          && request.resource.data.timestamp == request.time
          && ((isOwner(userId) && request.resource.data.from == 'user' && slowMode('support', 2))
              || (isAdmin() && request.resource.data.from == 'team'));

        allow update: if false;
        allow delete: if isAdmin();
      }
    }

    // ====================================================
    // 8. SUSPENSIONS
    // ====================================================
    // suspensions/{uid} pauses an account (see isSuspended). Only admins can lift one.

    match /suspensions/{userId} {
      allow read: if isOwner(userId) || isAdmin();

      // An admin suspends from the Inbox.
      allow create: if isAdmin()
        && request.resource.data.keys().hasAll(['source', 'reason', 'createdAt'])
        && request.resource.data.keys().hasOnly(['source', 'reason', 'createdAt', 'reportId'])
        && request.resource.data.source == 'admin'
        && request.resource.data.reason is string
        && request.resource.data.reason.size() >= 1
        && request.resource.data.reason.size() <= 300
        && (!('reportId' in request.resource.data) || request.resource.data.reportId is string)
        && request.resource.data.createdAt == request.time;

      // Automatic: someone reporting their chat partner as underage pauses that partner
      // until an admin reviews it. Only a real partner from that conversation can do this.
      allow create: if isAuthenticated()
        && request.auth.uid != userId
        && request.resource.data.keys().hasAll(['source', 'reason', 'createdAt', 'reporterId', 'convId'])
        && request.resource.data.keys().hasOnly(['source', 'reason', 'createdAt', 'reporterId', 'convId'])
        && request.resource.data.source == 'auto-underage'
        && request.resource.data.reason is string
        && request.resource.data.reason.size() >= 1
        && request.resource.data.reason.size() <= 300
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.convId is string
        && get(/databases/$(database)/documents/conversations/$(request.resource.data.convId)).data.participants.hasAll([request.auth.uid, userId]);

      allow update: if false;
      allow delete: if isAdmin();
    }

    // ====================================================
    // APP UPDATES ("What's New")
    // ====================================================
    // app_updates/{id}: written only by admins. Members can read published ones, never drafts.
    // app_update_reads/{uid}: which updates that member has opened, readable and writable only by them.

    function appUpdateValid(d) {
      return d.keys().hasAll(['title', 'body', 'category', 'status', 'createdAt', 'updatedAt', 'publishedAt'])
        && d.keys().hasOnly(['title', 'body', 'category', 'status', 'link', 'createdAt', 'updatedAt', 'publishedAt'])
        && d.title is string && d.title.size() >= 3 && d.title.size() <= 80
        && d.body is string && d.body.size() >= 1 && d.body.size() <= 500
        && d.category in ['feature', 'improvement', 'fix', 'announcement']
        && d.status in ['draft', 'published']
        && d.updatedAt == request.time
        && (d.status == 'published'
            ? (d.publishedAt is timestamp && d.publishedAt <= request.time)
            : (d.publishedAt == null || d.publishedAt is timestamp))
        && (!('link' in d)
            || (d.link is map
                && d.link.keys().hasAll(['url', 'label'])
                && d.link.keys().hasOnly(['url', 'label'])
                && d.link.url is string && d.link.url.size() <= 300 && d.link.url.matches('^https://[^ ]+$')
                && d.link.label is string && d.link.label.size() >= 1 && d.link.label.size() <= 30));
    }

    match /app_updates/{updateId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.status == 'published');
      allow create: if isAdmin() && appUpdateValid(request.resource.data)
        && request.resource.data.createdAt == request.time;
      allow update: if isAdmin() && appUpdateValid(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isAdmin() && resource.data.status == 'draft';
    }

    match /app_update_reads/{userId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['reads', 'updatedAt'])
        && request.resource.data.keys().hasAll(['reads', 'updatedAt'])
        && request.resource.data.reads is map
        && request.resource.data.reads.size() <= 200
        && request.resource.data.updatedAt == request.time;
    }

    // ====================================================
    // MEMBER ACTIVITY (daily active users, retention, sign-up source)
    // ====================================================
    // One document per member, member_activity/{uid}: the days they opened the app as day markers
    // ("d20261030": true) plus the first day and, once, where they came from. No content, no profile data.
    // The day is Philippine time (UTC+8) taken from the server clock, so a member can only mark today.
    // Only the member can write it, only admins and the member can read it, and nothing is ever deleted.

    function activityToday() {
      let t = request.time + duration.value(8, 'h');
      return t.year() * 10000 + t.month() * 100 + t.day();
    }

    function activityTodayKey() {
      return 'd' + string(activityToday());
    }

    match /member_activity/{userId} {
      allow read: if isOwner(userId) || isAdmin();

      allow create: if isOwner(userId)
        && isEligibleMember(userId)
        && request.resource.data.keys().hasAll(['firstDay', 'days'])
        && request.resource.data.keys().hasOnly(['firstDay', 'days', 'source'])
        && request.resource.data.firstDay == activityToday()
        && request.resource.data.days is map
        && request.resource.data.days.keys().hasOnly([activityTodayKey()])
        && request.resource.data.days[activityTodayKey()] == true
        && (!('source' in request.resource.data)
            || request.resource.data.source in ['tiktok', 'facebook', 'reddit', 'direct', 'referral', 'other']);

      // Later days only add today's marker; firstDay and source never change. There is no cap on the number of days:
      // a member can add one marker per day, so growth is one small entry a day (about 54 years fit under Firestore's
      // 40,000 index-entry limit per document).
      allow update: if isOwner(userId)
        && isEligibleMember(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['days'])
        && request.resource.data.days.diff(resource.data.days).affectedKeys().hasOnly([activityTodayKey()])
        && request.resource.data.days[activityTodayKey()] == true;

      allow delete: if false;
    }

    // ====================================================
    // SIGNALS (SERVER-MANAGED CONSENT RECORDS)
    // ====================================================
    // Invitation acceptance, expiry, idempotency, and pair creation are handled
    // by the authenticated Node.js API using Firebase Admin. Client SDK access
    // is intentionally denied; Admin SDK requests bypass these client rules.
    match /signalsInvitations/{invitationId} {
      allow read, write: if false;
    }

    match /signalsPairs/{pairId} {
      allow read, write: if false;
    }

    // Two Truths and a Lie answers (which statement is the lie). Server-only, so the answer cannot be read before the guess.
    match /signalsPairs/{pairId}/gameSecrets/{gameId} {
      allow read, write: if false;
    }

    match /signalsIdempotency/{requestId} {
      allow read, write: if false;
    }

    // Live-update feed for the owner only: a revision counter and pending invitation ids/expiry,
    // never sender identity. Written exclusively by the Signals API (Admin SDK).
    match /signalsInbox/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    // Trusted-API collections (private age ranges, rate limits, birthday corrections and their audit trail).
    // Only the Admin SDK touches them; clients have no access.
    match /matchPrefs/{userId} {
      allow read, write: if false;
    }
    match /apiRateLimits/{key} {
      allow read, write: if false;
    }
    match /birthdayCorrections/{userId} {
      allow read, write: if false;
    }
    match /ageAudit/{entryId} {
      allow read, write: if false;
    }

    match /signalsRateLimits/{userId} {
      allow read, write: if false;
    }


  }
}
