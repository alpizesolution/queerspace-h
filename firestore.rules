rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ====================================================
    // GLOBAL HELPER FUNCTIONS
    // ====================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Role Escalation Defense: Client-writable documents MUST NOT contain 'role', 'isAdmin', or 'isModerator'
    function hasNoPrivilegedFields() {
      return !('role' in request.resource.data) &&
             !('isAdmin' in request.resource.data) &&
             !('isModerator' in request.resource.data);
    }

    // Validates that a conversation has exactly 2 distinct UIDs, including request.auth.uid
    function isValidNewConversation() {
      let p = request.resource.data.participants;
      return p is list 
        && p.size() == 2 
        && p[0] is string 
        && p[1] is string 
        && p[0] != p[1] 
        && request.auth.uid in p;
    }

    // Verifies conversation participants cannot be modified after creation
    function areParticipantsUnchanged() {
      return request.resource.data.participants == resource.data.participants;
    }

    // Verifies if request user is a participant of an existing conversation
    function isConversationParticipant(convId) {
      return isAuthenticated() && 
        request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participants;
    }

    // Admins sign in with Google and have a doc at admins/{uid}, which can only be
    // created by hand in the Firebase Console. Anonymous accounts are never admins.
    function isAdmin() {
      return isAuthenticated()
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // A suspended account (suspensions/{uid}, see section 8) can still read and message
    // support, but can't match, chat, or post anywhere public.
    function isSuspended() {
      return exists(/databases/$(database)/documents/suspensions/$(request.auth.uid));
    }

    // An admin marking an inbox item (suggestion or report) as open or done.
    function isAdminStatusChange() {
      return isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['open', 'done'];
    }

    // Valid categories for community posts
    function isValidCategory(cat) {
      return cat in ['general', 'media', 'vents', 'friends', 'advice'];
    }

    // ====================================================
    // SLOW MODE (anti-spam)
    // ====================================================
    // rate_limits/{uid} remembers when a user last posted to each surface.
    // A post must stamp its field with request.time in the same batch, and is
    // only allowed if the previous stamp is at least `secs` seconds old.

    function rateLimitPath() {
      return /databases/$(database)/documents/rate_limits/$(request.auth.uid);
    }

    function slowMode(field, secs) {
      let before = exists(rateLimitPath()) ? get(rateLimitPath()).data : {};
      return getAfter(rateLimitPath()).data.get(field, null) == request.time
        && (!(field in before) || before[field] + duration.value(secs, 's') <= request.time);
    }

    match /rate_limits/{userId} {
      allow read: if isOwner(userId);
      // Only stamps of "now" can be written, so the clock can't be wound back.
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['publicRoom', 'unsaid', 'suggestion', 'communityPost', 'communityReply', 'support'])
        && (!('publicRoom' in request.resource.data.diff(resource == null ? {} : resource.data).affectedKeys())
            || request.resource.data.publicRoom == request.time)
        && (!('unsaid' in request.resource.data.diff(resource == null ? {} : resource.data).affectedKeys())
            || request.resource.data.unsaid == request.time)
        && (!('suggestion' in request.resource.data.diff(resource == null ? {} : resource.data).affectedKeys())
            || request.resource.data.suggestion == request.time)
        && (!('communityPost' in request.resource.data.diff(resource == null ? {} : resource.data).affectedKeys())
            || request.resource.data.communityPost == request.time)
        && (!('communityReply' in request.resource.data.diff(resource == null ? {} : resource.data).affectedKeys())
            || request.resource.data.communityReply == request.time)
        && (!('support' in request.resource.data.diff(resource == null ? {} : resource.data).affectedKeys())
            || request.resource.data.support == request.time);
      allow delete: if false;
    }

    match /admins/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    // ====================================================
    // 0. INDEXED COLLECTION GROUPS
    // ====================================================

    // Admin dashboard: counting members across users/{uid}/public/profile.
    match /{path=**}/public/{docId} {
      allow read: if isAdmin();
    }
    
    // Allow querying all public profiles across all users
    match /{path=**}/profile/{profileId} {
      allow read: if isAuthenticated();
    }

    // ====================================================
    // 1. PRIVACY BY DESIGN: USER PROFILES & PRIVATE SETTINGS
    // ====================================================

    // Private settings (SOGIE, exact location, matching filters, blocked user IDs)
    // READABLE & WRITABLE ONLY BY PROFILE OWNER. ZERO PUBLIC EXPOSURE.
    match /users/{userId}/private/settings {
      allow read: if isOwner(userId);

      allow create: if isOwner(userId)
        && hasNoPrivilegedFields()
        && request.resource.data.keys().hasAll(['createdAt', 'updatedAt'])
        && request.resource.data.keys().hasOnly([
             'exactLocation', 'sexualOrientation', 'genderExpression', 
             'preferredGenderExpressions', 'blockedPartnerIds', 'createdAt', 'updatedAt'
           ])
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;

      allow update: if isOwner(userId)
        && hasNoPrivilegedFields()
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.keys().hasOnly([
             'exactLocation', 'sexualOrientation', 'genderExpression', 
             'preferredGenderExpressions', 'blockedPartnerIds', 'createdAt', 'updatedAt'
           ])
        && request.resource.data.updatedAt is timestamp;

      allow delete: if false;
    }

    // Public Profile (displayName, pronouns, intention, region, topics)
    // READABLE BY ALL AUTHENTICATED USERS. WRITABLE ONLY BY OWNER.
    match /users/{userId}/public/profile {
      allow read: if isAuthenticated();

      allow create, update: if isOwner(userId)
        && hasNoPrivilegedFields()
        && request.resource.data.keys().hasAll(['displayName', 'pronouns', 'intention', 'region', 'topics', 'updatedAt'])
        && request.resource.data.keys().hasOnly([
             'displayName', 'pronouns', 'intention', 'topics', 
             'region', 'showGenderExpressionOnProfile', 'showSogieOnProfile', 
             'showLocationOnProfile', 'avatar', 'createdAt', 'updatedAt'
           ])
        // createdAt marks when someone joined: set once to "now", then never changed.
        && (resource != null && 'createdAt' in resource.data
            ? request.resource.data.createdAt == resource.data.createdAt
            : (!('createdAt' in request.resource.data) || request.resource.data.createdAt == request.time))
        && (!('avatar' in request.resource.data)
            || (request.resource.data.avatar is string && request.resource.data.avatar.size() <= 24))
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 1
        && request.resource.data.displayName.size() <= 30
        && request.resource.data.pronouns is string
        && request.resource.data.pronouns.size() >= 1
        && request.resource.data.pronouns.size() <= 20
        && request.resource.data.intention is string
        && request.resource.data.region is string
        && request.resource.data.topics is list
        && request.resource.data.topics.size() <= 8
        && request.resource.data.updatedAt is timestamp;

      allow delete: if false;
    }

    // ====================================================
    // 1b. LIVE MATCHMAKING QUEUE
    // ====================================================
    // match_queue/{uid}: a user's own "I'm looking for a chat" entry.
    // Only waiting entries are visible to others; matched entries are visible
    // to the owner and the person they were paired with.

    // Optional age (18-99), and with the age filter on, the age range the person wants.
    function queueAgeValid(d) {
      return (!('age' in d) || (d.age is int && d.age >= 18 && d.age <= 99))
        && (('ageMin' in d) == ('ageMax' in d))
        && (!('ageMin' in d)
            || (d.ageMin is int && d.ageMax is int && d.ageMin >= 18 && d.ageMax <= 99 && d.ageMin <= d.ageMax));
    }

    // Location and gender expression filters: short lists of option names.
    function queueListValid(d, key) {
      return !(key in d) || (d[key] is list && d[key].size() >= 1 && d[key].size() <= 20);
    }

    function queueKeysValid() {
      return request.resource.data.keys().hasOnly([
               'status', 'partnerId', 'convId', 'createdAt', 'heartbeatAt', 'updatedAt', 'age', 'ageMin', 'ageMax',
               'areas', 'wantAreas', 'expr', 'wantExpr'
             ])
        && request.resource.data.status in ['waiting', 'matched']
        && queueAgeValid(request.resource.data)
        && queueListValid(request.resource.data, 'areas')
        && queueListValid(request.resource.data, 'wantAreas')
        && queueListValid(request.resource.data, 'expr')
        && queueListValid(request.resource.data, 'wantExpr');
    }

    function convHasParticipants(convId, a, b) {
      return convId is string
        && getAfter(/databases/$(database)/documents/conversations/$(convId)).data.participants.hasAll([a, b]);
    }

    match /match_queue/{userId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == userId
        || resource.data.status == 'waiting'
        || resource.data.partnerId == request.auth.uid
      );

      allow create: if isOwner(userId)
        && !isSuspended()
        && queueKeysValid()
        && request.resource.data.status == 'waiting'
        && request.resource.data.createdAt is timestamp
        && request.resource.data.heartbeatAt is timestamp;

      // Owner: heartbeat, reset to waiting, or mark self matched with a real conversation.
      allow update: if isOwner(userId)
        && queueKeysValid()
        && (request.resource.data.status == 'waiting'
            || convHasParticipants(request.resource.data.convId, userId, request.resource.data.partnerId));

      // Another searcher claims a waiting entry, but only by pairing it with themselves
      // in a conversation created in the same transaction.
      allow update: if isAuthenticated()
        && request.auth.uid != userId
        && !isSuspended()
        && resource.data.status == 'waiting'
        && request.resource.data.status == 'matched'
        && request.resource.data.partnerId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'partnerId', 'convId', 'updatedAt'])
        && convHasParticipants(request.resource.data.convId, request.auth.uid, userId);

      allow delete: if isOwner(userId);
    }

    // ====================================================
    // 2. 1-ON-1 CONVERSATIONS & EPHEMERAL MESSAGES
    // ====================================================

    match /conversations/{convId} {
      // Admins can count conversations, but never read their messages.
      allow read: if isAuthenticated() && (request.auth.uid in resource.data.participants || isAdmin());

      allow create: if isAuthenticated()
        && isValidNewConversation()
        && request.resource.data.keys().hasAll(['participants', 'createdAt', 'updatedAt', 'status'])
        && request.resource.data.keys().hasOnly(['participants', 'createdAt', 'updatedAt', 'status'])
        && request.resource.data.status == 'active'
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;

      // Status Transition Lock: 'ended' or 'blocked' conversations cannot be changed back to 'active'
      allow update: if isAuthenticated()
        && request.auth.uid in resource.data.participants
        && areParticipantsUnchanged()
        && resource.data.status == 'active'
        && request.resource.data.keys().hasOnly(['participants', 'createdAt', 'updatedAt', 'status'])
        && request.resource.data.status in ['active', 'ended', 'blocked']
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt is timestamp;

      allow delete: if false;

      // A reply carries a short quote of the message it answers.
      function isValidReplyQuote(q) {
        return q is map
          && q.keys().hasAll(['id', 'text', 'senderId'])
          && q.keys().hasOnly(['id', 'text', 'senderId'])
          && q.id is string && q.id.size() >= 1 && q.id.size() <= 64
          && q.text is string && q.text.size() <= 140
          && q.senderId is string && q.senderId.size() <= 128;
      }

      // Ephemeral Chat Messages
      match /messages/{messageId} {
        allow read: if isConversationParticipant(convId);

        allow create: if isConversationParticipant(convId)
          && !isSuspended()
          && request.resource.data.keys().hasAll(['senderId', 'text', 'timestamp'])
          && request.resource.data.keys().hasOnly(['senderId', 'text', 'timestamp', 'replyTo'])
          && request.resource.data.senderId == request.auth.uid
          && (!('replyTo' in request.resource.data) || isValidReplyQuote(request.resource.data.replyTo))
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1
          && request.resource.data.text.size() <= 1000
          && request.resource.data.timestamp is timestamp;

        allow update, delete: if false; // Messages are immutable
      }
    }

    // ====================================================
    // 3. PUBLIC ROOM MESSAGES (TOWN SQUARE)
    // ====================================================

    function isValidRoomQuote(q) {
      return q is map
        && q.keys().hasAll(['id', 'author', 'text'])
        && q.keys().hasOnly(['id', 'author', 'text'])
        && q.id is string && q.id.size() >= 1 && q.id.size() <= 64
        && q.author is string && q.author.size() <= 30
        && q.text is string && q.text.size() <= 140;
    }

    match /public_room_messages/{messageId} {
      allow read: if isAuthenticated();

      allow create: if isAuthenticated()
        && request.resource.data.keys().hasAll(['authorId', 'authorName', 'authorPronouns', 'text', 'timestamp'])
        && request.resource.data.keys().hasOnly(['authorId', 'authorName', 'authorPronouns', 'authorAvatar', 'text', 'timestamp'])
        && request.resource.data.authorId == request.auth.uid
        && (!('authorAvatar' in request.resource.data)
            || (request.resource.data.authorAvatar is string && request.resource.data.authorAvatar.size() <= 24))
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() >= 1
        && request.resource.data.authorName.size() <= 30
        && request.resource.data.authorPronouns is string
        && request.resource.data.authorPronouns.size() >= 1
        && request.resource.data.authorPronouns.size() <= 20
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 1000
        && request.resource.data.timestamp == request.time
        && slowMode('publicRoom', 2)
        && !isSuspended();

      // Team announcements: only admins can post with the verified team flag (no slow mode),
      // optionally quoting the message they answer.
      allow create: if isAdmin()
        && request.resource.data.keys().hasAll(['authorId', 'authorName', 'authorPronouns', 'text', 'timestamp', 'team'])
        && request.resource.data.keys().hasOnly(['authorId', 'authorName', 'authorPronouns', 'text', 'timestamp', 'team', 'replyTo'])
        && (!('replyTo' in request.resource.data) || isValidRoomQuote(request.resource.data.replyTo))
        && request.resource.data.team == true
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() <= 30
        && request.resource.data.authorPronouns is string
        && request.resource.data.authorPronouns.size() <= 20
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 1000
        && request.resource.data.timestamp == request.time;

      allow update: if false; // Immutable public room messages
      allow delete: if isAdmin();
    }

    // ====================================================
    // 4. COMMUNITY POSTS, LIKES & REPLIES
    // ====================================================
    // Posts are shared with everyone. Like and reply counters live on the post and
    // can only move by one, together with the matching likes/{uid} or replies/{id}
    // doc in the same batch, so each person likes once and counts can't be faked.

    function postPath(postId) {
      return /databases/$(database)/documents/community_posts/$(postId);
    }

    function validAuthorFields(data) {
      return data.authorId == request.auth.uid
        && data.authorName is string
        && data.authorName.size() >= 1
        && data.authorName.size() <= 30
        && data.authorPronouns is string
        && data.authorPronouns.size() <= 20
        && (!('authorAvatar' in data) || (data.authorAvatar is string && data.authorAvatar.size() <= 24));
    }

    function counterMoves(field, by) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([field])
        && request.resource.data[field] == resource.data[field] + by;
    }

    match /community_posts/{postId} {
      allow read: if isAuthenticated();

      allow create: if isAuthenticated()
        && request.resource.data.keys().hasAll(['authorId', 'authorName', 'authorPronouns', 'title', 'content', 'category', 'tags', 'likes', 'replyCount', 'timestamp'])
        && request.resource.data.keys().hasOnly(['authorId', 'authorName', 'authorPronouns', 'authorAvatar', 'title', 'content', 'category', 'tags', 'likes', 'replyCount', 'timestamp'])
        && validAuthorFields(request.resource.data)
        && isValidCategory(request.resource.data.category)
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 1
        && request.resource.data.title.size() <= 90
        && request.resource.data.content is string
        && request.resource.data.content.size() >= 1
        && request.resource.data.content.size() <= 1000
        && request.resource.data.tags is list
        && request.resource.data.tags.size() <= 4
        && request.resource.data.likes == 0
        && request.resource.data.replyCount == 0
        && request.resource.data.timestamp == request.time
        && slowMode('communityPost', 30)
        && !isSuspended();

      // Like: +1 with a new likes/{uid} doc. Unlike: -1 while removing it.
      allow update: if isAuthenticated()
        && counterMoves('likes', 1)
        && !exists(/databases/$(database)/documents/community_posts/$(postId)/likes/$(request.auth.uid))
        && existsAfter(/databases/$(database)/documents/community_posts/$(postId)/likes/$(request.auth.uid));
      allow update: if isAuthenticated()
        && counterMoves('likes', -1)
        && exists(/databases/$(database)/documents/community_posts/$(postId)/likes/$(request.auth.uid))
        && !existsAfter(/databases/$(database)/documents/community_posts/$(postId)/likes/$(request.auth.uid));
      // Reply: +1, written in the same batch as the reply (checked on the reply doc).
      allow update: if isAuthenticated() && counterMoves('replyCount', 1) && slowMode('communityReply', 5);
      // Admin removing a reply: -1.
      allow update: if isAdmin() && counterMoves('replyCount', -1);

      allow delete: if isAuthenticated() && (request.auth.uid == resource.data.authorId || isAdmin());

      match /likes/{userId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.keys().hasOnly(['createdAt'])
          && request.resource.data.createdAt == request.time
          && getAfter(postPath(postId)).data.likes == get(postPath(postId)).data.likes + 1;
        allow delete: if isOwner(userId)
          && getAfter(postPath(postId)).data.likes == get(postPath(postId)).data.likes - 1;
        allow update: if false;
      }

      match /replies/{replyId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated()
          && request.resource.data.keys().hasAll(['authorId', 'authorName', 'authorPronouns', 'content', 'timestamp'])
          && request.resource.data.keys().hasOnly(['authorId', 'authorName', 'authorPronouns', 'authorAvatar', 'content', 'timestamp'])
          && validAuthorFields(request.resource.data)
          && request.resource.data.content is string
          && request.resource.data.content.size() >= 1
          && request.resource.data.content.size() <= 500
          && request.resource.data.timestamp == request.time
          && getAfter(postPath(postId)).data.replyCount == get(postPath(postId)).data.replyCount + 1
          && slowMode('communityReply', 5)
          && !isSuspended();
        allow delete: if isAdmin()
          && getAfter(postPath(postId)).data.replyCount == get(postPath(postId)).data.replyCount - 1;
        allow update: if false;
      }
    }

    // ====================================================
    // 5. ABUSE & SAFETY REPORTS
    // ====================================================

    match /reports/{reportId} {
      allow create: if isAuthenticated()
        && request.resource.data.keys().hasAll(['reporterId', 'targetId', 'targetType', 'reason', 'timestamp'])
        && request.resource.data.keys().hasOnly(['reporterId', 'targetId', 'targetType', 'reason', 'timestamp'])
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.targetId is string
        && request.resource.data.targetType in ['user', 'message', 'post']
        && request.resource.data.reason is string
        && request.resource.data.reason.size() >= 1
        && request.resource.data.reason.size() <= 300
        && request.resource.data.timestamp is timestamp;

      // Only admins can read reports; reporters can't see each other's.
      allow read, delete: if isAdmin();
      allow update: if isAdminStatusChange();
    }

    // ====================================================
    // 5b. UNSAID WALL (anonymous, fades after 48 hours)
    // ====================================================
    // Posts carry no author field. Ownership lives in unsaid_owners/{postId},
    // readable only by the author, so nobody can link a post to a profile.
    // Reaction and flag counters can only go up by one, together with a
    // per-user marker document, so each person counts once.

    function unsaidPath(postId) {
      return /databases/$(database)/documents/unsaid/$(postId);
    }

    function unsaidOwnerPath(postId) {
      return /databases/$(database)/documents/unsaid_owners/$(postId);
    }

    function bumpsOnly(field) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([field])
        && request.resource.data[field] == resource.data.get(field, 0) + 1;
    }

    match /unsaid/{postId} {
      allow read: if isAuthenticated();

      allow create: if isAuthenticated()
        && request.resource.data.keys().hasAll(['kind', 'text', 'createdAt', 'expiresAt', 'hugs', 'same', 'flags'])
        && request.resource.data.keys().hasOnly(['kind', 'text', 'createdAt', 'expiresAt', 'hugs', 'same', 'flags'])
        && request.resource.data.kind in ['vent', 'confession']
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 500
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time + duration.value(47, 'h')
        && request.resource.data.expiresAt < request.time + duration.value(49, 'h')
        && request.resource.data.hugs == 0
        && request.resource.data.same == 0
        && request.resource.data.flags == 0
        && getAfter(unsaidOwnerPath(postId)).data.authorId == request.auth.uid
        && slowMode('unsaid', 60)
        && !isSuspended();

      // A reaction: +1 on one reaction counter alongside a new reactions/{uid} doc of that type.
      // Counters added after launch (felt, strong, proud, cry) start missing and count from 0.
      allow update: if isAuthenticated()
        && (bumpsOnly('hugs') || bumpsOnly('same') || bumpsOnly('felt') || bumpsOnly('strong') || bumpsOnly('proud')
            || bumpsOnly('cry'))
        && !exists(/databases/$(database)/documents/unsaid/$(postId)/reactions/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/unsaid/$(postId)/reactions/$(request.auth.uid)).data.type
             in request.resource.data.diff(resource.data).affectedKeys();

      // A flag: +1 on 'flags' alongside a new flags/{uid} doc.
      allow update: if isAuthenticated()
        && bumpsOnly('flags')
        && !exists(/databases/$(database)/documents/unsaid/$(postId)/flags/$(request.auth.uid))
        && existsAfter(/databases/$(database)/documents/unsaid/$(postId)/flags/$(request.auth.uid));

      // Admin restore: clear the flags on a post that was wrongly hidden.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['flags'])
        && request.resource.data.flags == 0;

      allow delete: if isAuthenticated()
        && (get(unsaidOwnerPath(postId)).data.authorId == request.auth.uid || isAdmin());

      match /reactions/{userId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.keys().hasOnly(['type', 'createdAt'])
          && request.resource.data.type in ['hugs', 'same', 'felt', 'strong', 'proud', 'cry']
          && request.resource.data.createdAt == request.time
          && getAfter(unsaidPath(postId)).data[request.resource.data.type]
               == get(unsaidPath(postId)).data.get(request.resource.data.type, 0) + 1;
        allow update, delete: if false;
      }

      match /flags/{userId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.keys().hasOnly(['createdAt'])
          && request.resource.data.createdAt == request.time
          && getAfter(unsaidPath(postId)).data.flags == get(unsaidPath(postId)).data.flags + 1;
        allow update, delete: if false;
      }
    }

    match /unsaid_owners/{postId} {
      allow read: if isAuthenticated() && resource.data.authorId == request.auth.uid;

      // Only for a brand-new post, created in the same batch.
      allow create: if isAuthenticated()
        && request.resource.data.keys().hasOnly(['authorId'])
        && request.resource.data.authorId == request.auth.uid
        && !exists(unsaidPath(postId))
        && existsAfter(unsaidPath(postId));

      // Admins can clean up the owner record when removing a post, but still can't read it.
      allow delete: if isAuthenticated()
        && (resource.data.authorId == request.auth.uid || isAdmin())
        && !existsAfter(unsaidPath(postId));
      allow update: if false;
    }

    // ====================================================
    // 6. SUGGESTIONS & FEEDBACK
    // ====================================================
    // Write-only for users; admins read them on the /admin page.

    match /suggestions/{suggestionId} {
      allow create: if isAuthenticated()
        && request.resource.data.keys().hasAll(['authorId', 'category', 'text', 'createdAt'])
        && request.resource.data.keys().hasOnly(['authorId', 'category', 'text', 'createdAt'])
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.category in ['idea', 'bug', 'safety', 'other']
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 3
        && request.resource.data.text.size() <= 1000
        && request.resource.data.createdAt == request.time
        && slowMode('suggestion', 30);

      allow read, delete: if isAdmin();
      allow update: if isAdminStatusChange();
    }

    // ====================================================
    // 7. SUPPORT CHAT
    // ====================================================
    // One private thread per member (support_threads/{uid}), visible only to that member
    // and admins. The thread doc is a summary for the admin inbox; messages hold the chat.

    function supportSummaryValid() {
      let d = request.resource.data;
      return d.keys().hasOnly(['displayName', 'avatar', 'lastMessage', 'lastFrom', 'updatedAt', 'unreadForTeam', 'unreadForUser'])
        && d.lastMessage is string && d.lastMessage.size() <= 140
        && (!('displayName' in d) || (d.displayName is string && d.displayName.size() <= 30))
        && (!('avatar' in d) || (d.avatar is string && d.avatar.size() <= 24));
    }

    function supportChanged() {
      return request.resource.data.diff(resource == null ? {} : resource.data).affectedKeys();
    }

    match /support_threads/{userId} {
      allow read: if isOwner(userId) || isAdmin();

      // Member sends: summary says the member wrote last, stamped with their slow mode.
      allow create, update: if isOwner(userId)
        && supportSummaryValid()
        && request.resource.data.lastFrom == 'user'
        && request.resource.data.unreadForTeam == true
        && request.resource.data.updatedAt == request.time
        && !('unreadForUser' in supportChanged())
        && slowMode('support', 2);

      // Member opens the chat: clear their unread flag only.
      allow update: if isOwner(userId)
        && supportChanged().hasOnly(['unreadForUser'])
        && request.resource.data.unreadForUser == false;

      // Team replies, or opens the thread (clears the team's unread flag only).
      allow update: if isAdmin() && supportSummaryValid() && (
        (supportChanged().hasOnly(['lastMessage', 'lastFrom', 'updatedAt', 'unreadForUser', 'unreadForTeam'])
          && request.resource.data.lastFrom == 'team'
          && request.resource.data.unreadForUser == true
          && request.resource.data.updatedAt == request.time)
        || (supportChanged().hasOnly(['unreadForTeam']) && request.resource.data.unreadForTeam == false)
      );

      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isOwner(userId) || isAdmin();

        allow create: if request.resource.data.keys().hasAll(['from', 'text', 'timestamp'])
          && request.resource.data.keys().hasOnly(['from', 'text', 'timestamp'])
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1
          && request.resource.data.text.size() <= 1000
          && request.resource.data.timestamp == request.time
          && ((isOwner(userId) && request.resource.data.from == 'user' && slowMode('support', 2))
              || (isAdmin() && request.resource.data.from == 'team'));

        allow update: if false;
        allow delete: if isAdmin();
      }
    }

    // ====================================================
    // 8. SUSPENSIONS
    // ====================================================
    // suspensions/{uid} pauses an account (see isSuspended). Only admins can lift one.

    match /suspensions/{userId} {
      allow read: if isOwner(userId) || isAdmin();

      // An admin suspends from the Inbox.
      allow create: if isAdmin()
        && request.resource.data.keys().hasAll(['source', 'reason', 'createdAt'])
        && request.resource.data.keys().hasOnly(['source', 'reason', 'createdAt', 'reportId'])
        && request.resource.data.source == 'admin'
        && request.resource.data.reason is string
        && request.resource.data.reason.size() >= 1
        && request.resource.data.reason.size() <= 300
        && (!('reportId' in request.resource.data) || request.resource.data.reportId is string)
        && request.resource.data.createdAt == request.time;

      // Automatic: someone reporting their chat partner as underage pauses that partner
      // until an admin reviews it. Only a real partner from that conversation can do this.
      allow create: if isAuthenticated()
        && request.auth.uid != userId
        && request.resource.data.keys().hasAll(['source', 'reason', 'createdAt', 'reporterId', 'convId'])
        && request.resource.data.keys().hasOnly(['source', 'reason', 'createdAt', 'reporterId', 'convId'])
        && request.resource.data.source == 'auto-underage'
        && request.resource.data.reason is string
        && request.resource.data.reason.size() >= 1
        && request.resource.data.reason.size() <= 300
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.convId is string
        && get(/databases/$(database)/documents/conversations/$(request.resource.data.convId)).data.participants.hasAll([request.auth.uid, userId]);

      allow update: if false;
      allow delete: if isAdmin();
    }
  }
}
